---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isFresh } from '../../lib/fresh';
import { galleryMedia } from '../../lib/media';
import { newestFirst } from '../../lib/newest';
import { site } from '../../site.config';

const stories = newestFirst(
  await getCollection('stories', ({ data }) => !data.draft),
  (story) => story.data.pubDate,
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0),
);

const tiles = stories.map((story) => ({
  story,
  // Cover first; if that field is empty, first gallery shot still fills the tile.
  cover: galleryMedia(story.data.cover, story.data.gallery)[0] || null,
  fresh: isFresh(story.data.pubDate),
}));
---

<BaseLayout
  title="Rides"
  description="Ride stories from The Soul Searchers cycling blog. Climbs, coast roads, rest days, café notes."
>
  <section class="section">
    <div class="site-shell">
      <p class="eyebrow">Rides</p>
      <h1 class="section-title">The rides</h1>
      <p class="section-lead">
        Newest first. A dawn climb, Nice on the Côte d'Azur,<br />
        notes after you unclip. Open a ride.
      </p>

      <div class="grid">
        {
          tiles.map(({ story, cover, fresh }) => (
            <a class:list={['tile', { 'is-new': fresh }]} href={`/stories/${story.id}`}>
              <span class="frame">
                {
                  cover ? (
                    <img src={cover} alt="" width="800" height="600" loading="lazy" decoding="async" sizes="(max-width: 640px) 92vw, 400px" />
                  ) : (
                    <span class="awaiting">
                      <img src={site.logo} alt="" width="56" height="71" loading="lazy" />
                      <span>Photo coming</span>
                    </span>
                  )
                }
              </span>
              {fresh ? <p class="mark-new">New</p> : null}
              <h2>{story.data.headline}</h2>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1.75rem 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .tile {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .frame {
    display: block;
    overflow: hidden;
    border-radius: 0.85rem;
    aspect-ratio: 4 / 3;
    background: #121820;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover .frame img {
    transform: scale(1.04);
  }

  .awaiting {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #121820 0%, #1b2530 100%);
  }

  .awaiting img {
    width: 3.5rem;
    height: auto;
    opacity: 0.32;
    transition: none;
  }

  .awaiting span {
    color: rgba(215, 224, 232, 0.5);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .tile.is-new h2 {
    color: var(--crest-red);
  }

  .tile .mark-new {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crest-red);
  }
</style>
