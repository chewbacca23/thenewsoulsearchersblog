---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { galleryMedia } from '../../lib/media';
import { renderMarkdown } from '../../../cloudflare/fresh-ride.js';
import { planRidePhotos } from '../../../cloudflare/story-photos.js';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const photos = galleryMedia(story.data.cover, story.data.gallery);
const plan = planRidePhotos(photos, story.body, story.data.cover);
const storyHtml = renderMarkdown(plan.wovenBody);
---

<BaseLayout title={story.data.title} description={story.data.description} ogType="article">
  <article class="section">
    <div class="site-shell article">
      <p class="eyebrow">Ride</p>
      <h1>{story.data.headline}</h1>
      <p class="dek">{story.data.description}</p>

      {
        plan.hero && (
          <figure class="hero">
            <img src={plan.hero} alt="" width="1200" height="900" loading="eager" />
          </figure>
        )
      }

      <div class="prose" set:html={storyHtml} />

      <p class="back">
        <a href={`/postcard/${story.id}`}>Send this ride</a>
        <a href="/stories">← All rides</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 52rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
  }

  .dek {
    margin: 0 0 1.75rem;
    color: rgba(215, 224, 232, 0.75);
    font-size: 1.1rem;
  }

  .hero {
    margin: 0 0 2rem;
    overflow: hidden;
    border-radius: 0.9rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  .hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .prose {
    max-width: 42rem;
  }

  .prose :global(figure) {
    float: right;
    clear: right;
    width: min(38%, 12rem);
    margin: 0.15rem 0 1rem 1.15rem;
    overflow: hidden;
    border-radius: 0.7rem;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
  }

  .prose :global(figure img) {
    margin: 0;
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    box-shadow: none;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose::after {
    content: '';
    display: table;
    clear: both;
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    margin-top: 2.75rem;
  }

  .back a {
    color: var(--amber-hot);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .prose :global(figure) {
      float: none;
      width: min(100%, 16rem);
      margin: 0.85rem auto 1.15rem;
    }

    .prose :global(figure img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
