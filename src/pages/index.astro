---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoBackdrop from '../components/LogoBackdrop.astro';
import { getCollection } from 'astro:content';
import { collectFeed } from '../lib/feed';
import { galleryMedia } from '../lib/media';
import { buildRidePhotoHrefs, resolveHomeHeroSlides } from '../lib/home-hero';
import { newestFirst } from '../lib/newest';
import BrandMark from '../components/BrandMark.astro';
import { site } from '../site.config';
import homeSettings from '../content/settings/home.json';

const [shots, stories, pulses] = await Promise.all([
  getCollection('shots', ({ data }) => !data.draft),
  getCollection('stories', ({ data }) => !data.draft),
  getCollection('pulse', ({ data }) => !data.draft),
]);

const pulseTease = newestFirst(pulses, (entry) => entry.data.pubDate);

const ridesNewest = newestFirst(
  stories,
  (story) => story.data.pubDate,
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0),
);

// Newest ride cover first. A seventh ride drops the oldest cover off the dia.
const rideCovers = ridesNewest
  .map((story) => galleryMedia(story.data.cover, story.data.gallery)[0])
  .filter(Boolean);

const rideLinks = buildRidePhotoHrefs(
  ridesNewest.map((story) => ({ id: story.id, ...story.data })),
);

const allNow = collectFeed(
  shots.map((shot) => ({ id: shot.id, ...shot.data })),
  stories.map((story) => ({ id: story.id, ...story.data })),
);

// An inline script below shifts --dia-i by calendar day so a static deploy
// still opens on a different slide each morning.
const heroSlides = resolveHomeHeroSlides(
  homeSettings,
  allNow.map((item) => item.photo),
  rideCovers,
).map((photo) => ({
  photo,
  ride: rideLinks.get(photo) ?? null,
}));
const heroPhoto = heroSlides[0]?.photo || null;
const hasRideLinks = heroSlides.some((slide) => slide.ride);
---

<BaseLayout watermark={false}>
  {
    heroPhoto && (
      <link slot="head" rel="preload" as="image" href={heroPhoto} fetchpriority="high" />
    )
  }
  <section
    class:list={['hero', { 'has-photo': Boolean(heroPhoto), 'hero--ride-links': hasRideLinks }]}
    aria-label="Welcome"
  >
    <div class="sky">
      {
        heroSlides.length > 0 ? (
          <>
            <div
              class="hero-dia"
              data-hero-dia
              data-count={heroSlides.length}
              style={`--dia-count: ${heroSlides.length};`}
              aria-label="Open the ride for this photo"
            >
              {
                heroSlides.map(({ photo, ride }, index) => (
                  <img
                    class="hero-photo"
                    src={photo}
                    alt={ride ? ride.label : ''}
                    width="1920"
                    height="1080"
                    decoding={index === 0 ? 'sync' : 'async'}
                    fetchpriority={index === 0 ? 'high' : 'low'}
                    loading="eager"
                    style={`--dia-i: ${index};`}
                    data-ride-href={ride?.href}
                  />
                ))
              }
            </div>
            {/*
              Rebuilds --dia-i from the calendar day so returning fans land
              on a different opener even when the HTML was built days ago.
              Click the photo (or through the title stack) to open that ride.
            */}
            <script is:inline>
              (() => {
                const dia = document.querySelector('[data-hero-dia]');
                if (!dia) return;
                const imgs = [...dia.querySelectorAll('.hero-photo')];
                const n = imgs.length;
                if (n >= 2) {
                  const offset = Math.floor(Date.now() / 86400000) % n;
                  imgs.forEach((img, i) => {
                    img.style.setProperty('--dia-i', String((i - offset + n) % n));
                  });
                }

                function currentRideHref() {
                  let best = null;
                  let bestOpacity = -1;
                  for (const img of dia.querySelectorAll('.hero-photo')) {
                    const href = img.getAttribute('data-ride-href');
                    if (!href) continue;
                    const opacity = parseFloat(getComputedStyle(img).opacity) || 0;
                    if (opacity > bestOpacity) {
                      bestOpacity = opacity;
                      best = href;
                    }
                  }
                  return best;
                }

                const hero = dia.closest('.hero');
                if (!hero) return;

                function openRide(event) {
                  if (event.target.closest('a, button, input, label')) return;
                  const href = currentRideHref();
                  if (!href) return;
                  event.preventDefault();
                  window.location.href = href;
                }

                hero.addEventListener('click', openRide);
                hero.addEventListener('keydown', (event) => {
                  if (event.key !== 'Enter' && event.key !== ' ') return;
                  if (event.target !== hero) return;
                  const href = currentRideHref();
                  if (!href) return;
                  event.preventDefault();
                  window.location.href = href;
                });
                if (dia.querySelector('[data-ride-href]')) {
                  hero.tabIndex = 0;
                }
              })();
            </script>
            <div class="hero-scrim" aria-hidden="true"></div>
          </>
        ) : (
          <>
            <LogoBackdrop variant="hero" />
            <div class="sky-aurora"></div>
            <div class="sky-stars">
              <span></span><span></span><span></span><span></span><span></span>
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="sky-horizon"></div>
          </>
        )
      }
    </div>

    <div class="site-shell hero-copy">
      <img class="hero-logo reveal" src={site.logo} alt={site.mark} width="88" height="112" decoding="async" />
      <p class="brand-hero reveal reveal-delay-1"><BrandMark /></p>
      <h1 class="reveal reveal-delay-2">A cycling Blog</h1>
      <p class="hero-lead reveal reveal-delay-3">
        Tours and café stops, a bike in the luggage car.<br />
        We ride to see this planet from the saddle. Clip in.
      </p>
      <div class="hero-actions reveal reveal-delay-3">
        <a class="btn btn-primary" href="/stories">The rides</a>
      </div>
    </div>
  </section>

  <section class="section pulse-tease-section" aria-label="Thin tires">
    <div class="site-shell pulse-tease">
      <div class="pulse-tease-head">
        <div>
          <p class="eyebrow">Thin tires</p>
          <p class="pulse-tease-lead">
            Road men, road women, cyclo-cross — refreshed every couple of days.
          </p>
        </div>
        <a class="pulse-tease-all" href="/pulse">All the pulse</a>
      </div>
      <ol class="pulse-tease-list" data-pulse-tease>
        {
          (() => {
            const lanes = [
              { id: 'road-men', label: 'Road race — men', kicker: 'Peloton' },
              { id: 'road-women', label: 'Road race — women', kicker: 'WorldTour' },
              { id: 'cyclo-cross', label: 'Cyclo-cross', kicker: 'Mud' },
            ];
            const picks = lanes
              .map((lane) => {
                const hit = pulseTease.find(
                  (entry) => (entry.data.section || 'road-men') === lane.id,
                );
                return hit ? { lane, entry: hit } : null;
              })
              .filter(Boolean);
            if (picks.length === 0) {
              return (
                <li class="empty">
                  <a href="/pulse">Thin tires</a> — road and CX when it lands.
                </li>
              );
            }
            return picks.map(({ lane, entry }) => (
              <li class={`pulse-tease-item pulse-tease-item--${lane.id}`}>
                {entry.data.image ? (
                  <a
                    class="pulse-tease-media"
                    href={entry.data.url || '/pulse'}
                    target={entry.data.url ? '_blank' : undefined}
                    rel={entry.data.url ? 'noopener noreferrer' : undefined}
                  >
                    <img
                      src={entry.data.image}
                      alt=""
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  </a>
                ) : (
                  <span class={`pulse-tease-media pulse-tease-media--blank`} aria-hidden="true" />
                )}
                <div class="pulse-tease-copy">
                  <span class="pulse-tease-lane">{lane.kicker}</span>
                  {entry.data.url ? (
                    <a class="pulse-tease-title" href={entry.data.url} target="_blank" rel="noopener noreferrer">
                      {entry.data.title}
                    </a>
                  ) : (
                    <span class="pulse-tease-title">{entry.data.title}</span>
                  )}
                  {entry.data.source ? (
                    <span class="pulse-tease-source">{entry.data.source}</span>
                  ) : null}
                </div>
              </li>
            ));
          })()
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .pulse-tease-section {
    padding-top: 2.75rem;
    padding-bottom: 3.75rem;
    border-top: 1px solid rgba(215, 224, 232, 0.08);
    background:
      radial-gradient(ellipse 70% 80% at 10% 0%, rgba(30, 58, 69, 0.28), transparent 55%),
      radial-gradient(ellipse 50% 60% at 90% 20%, rgba(212, 163, 90, 0.06), transparent 50%);
  }

  .pulse-tease {
    max-width: 56rem;
  }

  .pulse-tease-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .pulse-tease-head .eyebrow {
    margin: 0 0 0.35rem;
  }

  .pulse-tease-all {
    color: var(--amber-hot);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .pulse-tease-lead {
    margin: 0;
    color: rgba(215, 224, 232, 0.72);
    max-width: 28rem;
  }

  .pulse-tease-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 800px) {
    .pulse-tease-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .pulse-tease-item {
    --pulse-accent: var(--amber-hot);
    display: grid;
    gap: 0.75rem;
    padding: 0.7rem;
    border: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 0.95rem;
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(212, 163, 90, 0.12), transparent 55%),
      rgba(8, 12, 17, 0.45);
    transition:
      border-color 180ms ease,
      transform 220ms ease;
  }

  .pulse-tease-item--road-women {
    --pulse-accent: #7eb8c9;
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(61, 107, 122, 0.28), transparent 55%),
      rgba(8, 12, 17, 0.45);
  }

  .pulse-tease-item--cyclo-cross {
    --pulse-accent: var(--crest-red);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(227, 27, 35, 0.14), transparent 55%),
      rgba(8, 12, 17, 0.45);
  }

  .pulse-tease-item:hover {
    border-color: rgba(215, 224, 232, 0.22);
    transform: translateY(-2px);
  }

  .pulse-tease-media {
    display: block;
    overflow: hidden;
    border-radius: 0.65rem;
    aspect-ratio: 16 / 10;
    background: #121820;
  }

  .pulse-tease-media--blank {
    background:
      linear-gradient(135deg, rgba(215, 224, 232, 0.08), transparent 55%),
      #121820;
  }

  .pulse-tease-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pulse-tease-item:hover .pulse-tease-media img {
    transform: scale(1.05);
  }

  .pulse-tease-copy {
    display: grid;
    gap: 0.3rem;
    padding: 0 0.15rem 0.15rem;
  }

  .pulse-tease-lane,
  .pulse-tease-source {
    color: var(--pulse-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pulse-tease-source {
    opacity: 0.8;
  }

  .pulse-tease-title {
    color: var(--paper);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  a.pulse-tease-title:hover {
    color: var(--pulse-accent);
  }

  .hero {
    position: relative;
    min-height: calc(100vh - 4.25rem);
    min-height: calc(100dvh - 4.25rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 85% 60% at 72% 18%, rgba(61, 107, 122, 0.38), transparent 62%),
      radial-gradient(ellipse 55% 50% at 12% 28%, rgba(212, 163, 90, 0.14), transparent 58%),
      linear-gradient(180deg, #080c11 0%, #0f1820 45%, #182a36 70%, #2a2218 100%);
  }

  .hero-dia {
    position: absolute;
    inset: 0;
  }

  .hero--ride-links {
    cursor: pointer;
  }

  .hero--ride-links .hero-copy {
    pointer-events: none;
  }

  .hero--ride-links .hero-copy a,
  .hero--ride-links .hero-copy .btn,
  .hero--ride-links .hero-copy button {
    pointer-events: auto;
    cursor: pointer;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 36%;
    transform: scale(1.05);
    opacity: 0;
    will-change: opacity;
  }

  /* One shot: stay visible. */
  .hero-dia[data-count='1'] .hero-photo {
    opacity: 1;
  }

  /*
   * Soft dia: about nine seconds each. One slot per shot (100% / N) so a
   * frame cannot linger into the one after next. Short ease-in-out overlap.
   * CSS-only so Mac Reduce Motion / blocked JS cannot freeze on one shot.
   */
  .hero-dia[data-count='2'] .hero-photo,
  .hero-dia[data-count='3'] .hero-photo,
  .hero-dia[data-count='4'] .hero-photo,
  .hero-dia[data-count='5'] .hero-photo,
  .hero-dia[data-count='6'] .hero-photo {
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    animation-duration: calc(var(--dia-count) * 9s);
    animation-delay: calc(var(--dia-i) * 9s);
  }

  .hero-dia[data-count='2'] .hero-photo { animation-name: hero-dia-fade-2; }
  .hero-dia[data-count='3'] .hero-photo { animation-name: hero-dia-fade-3; }
  .hero-dia[data-count='4'] .hero-photo { animation-name: hero-dia-fade-4; }
  .hero-dia[data-count='5'] .hero-photo { animation-name: hero-dia-fade-5; }
  .hero-dia[data-count='6'] .hero-photo { animation-name: hero-dia-fade-6; }

  /* Hold until the next slot, then a short crossfade (~8% of the loop). */
  @keyframes hero-dia-fade-2 {
    0%, 4% { opacity: 0; }
    10%, 50% { opacity: 1; }
    58%, 100% { opacity: 0; }
  }
  @keyframes hero-dia-fade-3 {
    0%, 3% { opacity: 0; }
    8%, 33% { opacity: 1; }
    41%, 100% { opacity: 0; }
  }
  @keyframes hero-dia-fade-4 {
    0%, 2% { opacity: 0; }
    7%, 25% { opacity: 1; }
    33%, 100% { opacity: 0; }
  }
  @keyframes hero-dia-fade-5 {
    0%, 2% { opacity: 0; }
    6%, 20% { opacity: 1; }
    28%, 100% { opacity: 0; }
  }
  @keyframes hero-dia-fade-6 {
    0%, 2% { opacity: 0; }
    5%, 17% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(8, 12, 17, 0.28) 0%, rgba(8, 12, 17, 0.12) 34%, rgba(8, 12, 17, 0.55) 68%, rgba(8, 12, 17, 0.88) 100%),
      radial-gradient(ellipse 70% 55% at 18% 78%, rgba(8, 12, 17, 0.45), transparent 70%);
  }

  .sky :global(.logo-backdrop) {
    position: absolute;
  }

  .sky-aurora {
    position: absolute;
    inset: -10% -5% 35%;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(61, 107, 122, 0.35), transparent 55%),
      radial-gradient(ellipse at 70% 30%, rgba(240, 194, 122, 0.18), transparent 50%);
    filter: blur(18px);
    animation: aurora 14s ease-in-out infinite;
  }

  .sky-stars {
    position: absolute;
    inset: 0 0 35%;
  }

  .sky-stars span {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #eef3f7;
    animation: twinkle 3.8s ease-in-out infinite;
  }

  .sky-stars span:nth-child(1) { top: 12%; left: 8%; animation-delay: 0.2s; }
  .sky-stars span:nth-child(2) { top: 18%; left: 24%; width: 3px; height: 3px; animation-delay: 0.8s; }
  .sky-stars span:nth-child(3) { top: 9%; left: 46%; animation-delay: 1.4s; }
  .sky-stars span:nth-child(4) { top: 22%; left: 63%; animation-delay: 0.5s; }
  .sky-stars span:nth-child(5) { top: 14%; left: 78%; width: 3px; height: 3px; animation-delay: 1.1s; }
  .sky-stars span:nth-child(6) { top: 32%; left: 15%; animation-delay: 1.7s; }
  .sky-stars span:nth-child(7) { top: 28%; left: 38%; animation-delay: 0.3s; }
  .sky-stars span:nth-child(8) { top: 36%; left: 55%; animation-delay: 2s; }
  .sky-stars span:nth-child(9) { top: 26%; left: 84%; animation-delay: 0.9s; }
  .sky-stars span:nth-child(10) { top: 40%; left: 72%; width: 3px; height: 3px; animation-delay: 1.5s; }

  .sky-horizon {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background:
      linear-gradient(180deg, transparent, rgba(58, 42, 28, 0.55) 40%, rgba(12, 18, 24, 0.92)),
      radial-gradient(ellipse 90% 70% at 50% 100%, rgba(212, 163, 90, 0.28), transparent 70%);
  }

  .hero-copy {
    /* Crest height — wordmark matches it. */
    --crest-h: clamp(5.5rem, 16vw, 8.75rem);
    position: relative;
    z-index: 3;
    padding: 7rem 0 5.5rem;
    max-width: 44rem;
  }

  .hero-logo {
    position: relative;
    z-index: 1;
    width: auto;
    height: var(--crest-h);
    margin-bottom: 0.85rem;
    opacity: 0.92;
    filter: drop-shadow(0 12px 32px rgba(212, 163, 90, 0.25));
  }

  .brand-hero {
    position: relative;
    z-index: 0;
    isolation: isolate;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: var(--crest-h);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: 0;
    color: var(--paper);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  h1 {
    position: relative;
    z-index: 1;
    margin: 0 0 1rem;
    max-width: 18ch;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    font-weight: 400;
    color: rgba(238, 243, 247, 0.92);
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
  }

  .hero-lead {
    position: relative;
    z-index: 1;
    margin: 0 0 1.75rem;
    max-width: 34rem;
    color: rgba(215, 224, 232, 0.88);
    font-size: 1.08rem;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100vh - 10rem);
      min-height: calc(100dvh - 10rem);
    }

    .hero-copy {
      --crest-h: clamp(3.4rem, 22vw, 4.6rem);
      padding: 2.25rem 0 1.35rem;
    }

    .hero-logo {
      margin-bottom: 0.45rem;
    }

    .brand-hero {
      margin-bottom: 0.45rem;
      line-height: 0.85;
    }

    h1 {
      margin-bottom: 0.45rem;
      font-size: 1.08rem;
    }

    .hero-lead {
      margin-bottom: 0.9rem;
      font-size: 0.92rem;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      transform: scale(1.04);
    }
  }
</style>
