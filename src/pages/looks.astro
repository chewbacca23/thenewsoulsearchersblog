---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberDelete from '../components/MemberDelete.astro';
---

<BaseLayout
  title="Looks"
  description="How many times people opened pages on The Soul Searchers."
  robots="noindex, nofollow"
>
  <section class="section">
    <div class="site-shell looks">
      <p class="eyebrow">Open counts</p>
      <h1 class="section-title">Looks</h1>
      <p class="section-lead">
        Private for you. Opens per page, day, week, and month — Berlin calendar. Latest opens keep
        path, place, IP, and referrer for the last 10 hits — not on the public site. Counts start
        after this Worker is live.
      </p>

      <div class="looks-board" role="group" aria-label="Summary counts">
        <p class="looks-board-mark" aria-hidden="true">Looks</p>
        <div class="looks-board-row">
          <article class="looks-bay">
            <p class="looks-bay-label">Today</p>
            <p class="card-num" data-looks="today">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">7 days</p>
            <p class="card-num" data-looks="week">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Month</p>
            <p class="card-num" data-looks="month">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Year</p>
            <p class="card-num" data-looks="year">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Total</p>
            <p class="card-num" data-looks="total">—</p>
          </article>
        </div>
      </div>
      <script is:inline>
        (function () {
          var DIGITS = '0123456789';
          var reduce =
            window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function parseTarget(raw) {
            var text = String(raw || '').trim();
            if (!text || text === '—' || text === '-' || text === '–') return null;
            var digits = text.replace(/[^\d]/g, '');
            if (!digits) return null;
            return (digits.replace(/^0+(?=\d)/, '') || '0').slice(0, 5);
          }

          function wait(ms) {
            return new Promise(function (resolve) {
              setTimeout(resolve, ms);
            });
          }

          function flapHtml(ch) {
            return (
              '<span class="solari-flap" aria-hidden="true">' +
              '<span class="solari-flap-text">' +
              ch +
              '</span>' +
              '</span>'
            );
          }

          async function flipTo(flap, toCh) {
            var text = flap.querySelector('.solari-flap-text');
            if (!text) return;
            if (reduce) {
              text.textContent = toCh;
              return;
            }
            flap.classList.remove('is-flipping');
            void flap.offsetWidth;
            flap.classList.add('is-flipping');
            await wait(140);
            text.textContent = toCh;
            await wait(160);
            flap.classList.remove('is-flipping');
          }

          async function runFlap(flap, finalCh, delay) {
            await wait(delay);
            var text = flap.querySelector('.solari-flap-text');
            if (!text) return;
            if (reduce || finalCh === '—') {
              text.textContent = finalCh;
              return;
            }
            var spins = 3 + Math.floor(Math.random() * 3);
            for (var i = 0; i < spins; i++) {
              var next =
                i === spins - 1 ? finalCh : DIGITS[Math.floor(Math.random() * 10)];
              await flipTo(flap, next);
            }
            if (text.textContent !== finalCh) await flipTo(flap, finalCh);
          }

          function mount(el) {
            if (!el || el.dataset.flapReady === '1') return;
            if (!el.classList.contains('card-num')) return;
            var target = parseTarget(el.textContent);
            var chars = target ? target.split('') : ['—'];
            el.dataset.flapReady = '1';
            el.setAttribute('aria-label', target || '—');
            el.classList.add('is-solari');
            el.innerHTML =
              '<span class="solari-row">' + chars.map(flapHtml).join('') + '</span>';
            el.querySelectorAll('.solari-flap').forEach(function (flap, i) {
              runFlap(flap, chars[i], 60 + i * 90);
            });
          }

          function boot() {
            document.querySelectorAll('.card-num[data-looks]').forEach(mount);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
          } else {
            boot();
          }
        })();
      </script>

      <h2 class="pages-title">
        Latest opens <span data-looks-recent-count>—</span>
      </h2>
      <p class="note">
        Each row is one real page open. Newest first — path, city, country, IP, referrer. City is
        Cloudflare IP geo (~60–80% right; VPN / mobile hubs can miss). Private for you. Open Home
        in another tab, refresh, and watch a row land.
      </p>
      <ol class="pages" data-looks-recent>
        <li class="empty">Open any public page in another tab, then refresh — a row shows here.</li>
      </ol>
      <script type="application/json" data-looks-recent-json>[]</script>
      <script is:inline>
        (function () {
          var dataEl = document.querySelector('[data-looks-recent-json]');
          var list = document.querySelector('ol[data-looks-recent]');
          if (!dataEl || !list) return;
          var rows;
          try {
            rows = JSON.parse(dataEl.textContent || '[]');
          } catch (err) {
            return;
          }
          if (!Array.isArray(rows) || !rows.length) return;
          if (list.querySelector('.looks-recent')) return;

          function esc(value) {
            return String(value)
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
          }
          function whenLabel(iso) {
            var at = new Date(iso);
            if (isNaN(at.getTime())) return '—';
            return new Intl.DateTimeFormat('en-GB', {
              timeZone: 'Europe/Berlin',
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
              hour12: false,
            }).format(at);
          }
          list.innerHTML = rows
            .map(function (row) {
              var path = row.path === '/' ? 'Home' : esc(row.path || '/');
              var href = esc(row.path || '/');
              var bits = [];
              if (row.city) bits.push(esc(row.city));
              if (row.country) bits.push(esc(row.country));
              if (row.ip) bits.push(esc(row.ip));
              if (row.from) bits.push(esc(row.from));
              var meta = bits.length
                ? '<span class="looks-recent-meta">' + bits.join(' · ') + '</span>'
                : '';
              return (
                '<li class="looks-recent">' +
                '<span class="looks-recent-main">' +
                '<a href="' +
                href +
                '">' +
                path +
                '</a>' +
                meta +
                '</span>' +
                '<span class="looks-recent-when">' +
                esc(whenLabel(row.t)) +
                '</span>' +
                '</li>'
              );
            })
            .join('');
          var countEl = document.querySelector('[data-looks-recent-count]');
          if (countEl) countEl.textContent = String(rows.length);
        })();
      </script>

      <h2 class="pages-title">14 days</h2>
      <p class="note">Berlin days. Column height ∝ opens. Max column = busiest day.</p>
      <ol class="looks-bars" data-looks-days>
        <li class="empty">Day bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">8 weeks</h2>
      <p class="note">Each column = 7 days. Compare this week to last.</p>
      <ol class="looks-bars" data-looks-weeks>
        <li class="empty">Week bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">12 months</h2>
      <p class="note">Berlin calendar months. Column height ∝ opens. Max column = busiest month.</p>
      <ol class="looks-bars" data-looks-months>
        <li class="empty">Month bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Years</h2>
      <ol class="pages" data-looks-years>
        <li class="empty">Years show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Pages</h2>
      <ol class="pages" data-looks-pages>
        <li class="empty">Open Home or a ride, then refresh this page.</li>
      </ol>

      <h2 class="pages-title">Cities</h2>
      <p class="note">
        From the visitor’s IP via Cloudflare geo — roughly <strong>60–80%</strong> right at city
        level (country is usually stronger). Think “this network looks like Chicago / Amsterdam,”
        not a GPS pin. VPN, corporate gateways, and mobile hubs can land on the wrong town. New
        opens only from now on.
      </p>
      <ol class="pages" data-looks-cities>
        <li class="empty">City shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Countries</h2>
      <p class="note">
        Same IP geo as cities, but country is typically more reliable than town (~90%+ in practice).
      </p>
      <ol class="pages" data-looks-countries>
        <li class="empty">Country shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Referrers</h2>
      <p class="note">
        Tap a name to open that site. Browsers often hide the exact post — you get the network, not
        the single link.
      </p>
      <ol class="pages" data-looks-from>
        <li class="empty">The site that sent them shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">
        Free members <span data-members-count>—</span>
      </h2>
      <p class="note">
        Private for you. Everyone who joined the free list, newest first. Names and emails stay off
        the public site.
      </p>
      <ol class="pages" data-members-list>
        <li class="empty">No free members yet. When someone joins, they show here.</li>
      </ol>

      <h2 class="pages-title">
        Postcards started <span data-postcard-shares-count>—</span>
      </h2>
      <p class="note">
        Private for you. Someone tapped Send this ride; they send it themselves. Newest first.
      </p>
      <ol class="pages" data-postcard-shares-list>
        <li class="empty">No postcards started yet. When someone taps Send this ride, it shows here.</li>
      </ol>
    </div>
  </section>
  <MemberDelete />
</BaseLayout>

<style>
  .looks {
    max-width: 46rem;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Solari-style airport strip — top row only */
  .looks-board {
    margin: 1.75rem 0 2.25rem;
    padding: 0.85rem 0.75rem 1rem;
    border-radius: 0.55rem;
    background: #141414;
    border: 1px solid #0a0a0a;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .looks-board-mark {
    margin: 0 0 0.75rem;
    color: #f5f5f5;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
  }

  .looks-board-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.55rem;
  }

  @media (max-width: 719px) {
    .looks-board-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .looks-bay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    overflow: hidden;
  }

  .looks-bay-label {
    margin: 0;
    color: #e0b84e;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }

  .card-num {
    margin: 0;
    max-width: 100%;
    overflow: hidden;
    color: #fff;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .card-num.is-solari {
    display: flex;
    justify-content: center;
  }

  .solari-row {
    display: inline-flex;
    gap: 3px;
    align-items: center;
    justify-content: center;
    max-width: 100%;
  }

  .solari-flap {
    position: relative;
    flex: 0 0 auto;
    width: 22px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background:
      linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 48%, #0d0d0d 52%, #171717 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55);
    overflow: hidden;
    perspective: 240px;
  }

  .solari-flap::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    z-index: 2;
    height: 2px;
    margin-top: -1px;
    background: #000;
    pointer-events: none;
  }

  .solari-flap-text {
    position: relative;
    z-index: 1;
    color: #f7f7f7;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
    transform-origin: 50% 50%;
  }

  .solari-flap.is-flipping .solari-flap-text {
    animation: solari-tick 0.3s ease-in-out;
  }

  @keyframes solari-tick {
    0% {
      transform: rotateX(0deg);
    }
    45% {
      transform: rotateX(-90deg);
    }
    55% {
      transform: rotateX(-90deg);
    }
    100% {
      transform: rotateX(0deg);
    }
  }

  @media (max-width: 719px) {
    .solari-flap {
      width: 18px;
      height: 28px;
    }

    .solari-flap-text {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solari-flap.is-flipping .solari-flap-text {
      animation: none;
    }
  }
</style>
