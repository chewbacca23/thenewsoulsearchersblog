---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberDelete from '../components/MemberDelete.astro';
---

<BaseLayout
  title="Looks"
  description="How many times people opened pages on The Soul Searchers."
  robots="noindex, nofollow"
>
  <section class="section">
    <div class="site-shell looks">
      <p class="eyebrow">Open counts</p>
      <h1 class="section-title">Looks</h1>
      <p class="section-lead">
        Private for you. Opens per page, day, week, and month — Berlin calendar. Latest opens keep
        path, place, IP, and referrer for the last 10 hits — not on the public site. Counts start
        after this Worker is live.
      </p>

      <div class="looks-board" role="group" aria-label="Summary counts">
        <p class="looks-board-mark" aria-hidden="true">Looks · Berlin</p>
        <div class="looks-board-row">
          <article class="looks-bay">
            <p class="looks-bay-label">Today</p>
            <p class="card-num" data-looks="today">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">7 days</p>
            <p class="card-num" data-looks="week">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Month</p>
            <p class="card-num" data-looks="month">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Year</p>
            <p class="card-num" data-looks="year">—</p>
          </article>
          <article class="looks-bay">
            <p class="looks-bay-label">Total</p>
            <p class="card-num" data-looks="total">—</p>
          </article>
        </div>
      </div>
      <script is:inline>
        (function () {
          var DIGITS = '0123456789';
          var reduce =
            typeof window !== 'undefined' &&
            window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function parseTarget(raw) {
            var text = String(raw || '').trim();
            if (!text || text === '—' || text === '-' || text === '–') return null;
            var digits = text.replace(/[^\d]/g, '');
            if (!digits) return null;
            return digits.replace(/^0+(?=\d)/, '') || '0';
          }

          function cellHtml(ch) {
            return (
              '<span class="flap-cell" aria-hidden="true">' +
              '<span class="flap-panel flap-top"><span class="flap-glyph">' +
              ch +
              '</span></span>' +
              '<span class="flap-panel flap-bottom"><span class="flap-glyph">' +
              ch +
              '</span></span>' +
              '<span class="flap-hinge" hidden>' +
              '<span class="flap-face flap-front"><span class="flap-glyph"></span></span>' +
              '<span class="flap-face flap-back"><span class="flap-glyph"></span></span>' +
              '</span>' +
              '</span>'
            );
          }

          function setFull(cell, ch) {
            var top = cell.querySelector('.flap-top .flap-glyph');
            var bottom = cell.querySelector('.flap-bottom .flap-glyph');
            if (top) top.textContent = ch;
            if (bottom) bottom.textContent = ch;
          }

          function flipOnce(cell, fromCh, toCh) {
            return new Promise(function (resolve) {
              var hinge = cell.querySelector('.flap-hinge');
              var front = cell.querySelector('.flap-front .flap-glyph');
              var back = cell.querySelector('.flap-back .flap-glyph');
              var top = cell.querySelector('.flap-top .flap-glyph');
              var bottom = cell.querySelector('.flap-bottom .flap-glyph');
              if (!hinge || !front || !back || !top || !bottom) {
                setFull(cell, toCh);
                resolve();
                return;
              }
              // Classic Solari: top stays old, bottom already shows new, card flaps down.
              top.textContent = fromCh;
              bottom.textContent = toCh;
              front.textContent = fromCh;
              back.textContent = toCh;
              hinge.hidden = false;
              hinge.classList.remove('is-flipping');
              void hinge.offsetWidth;
              hinge.classList.add('is-flipping');
              var done = false;
              function finish() {
                if (done) return;
                done = true;
                hinge.classList.remove('is-flipping');
                hinge.hidden = true;
                setFull(cell, toCh);
                resolve();
              }
              hinge.addEventListener('animationend', finish, { once: true });
              setTimeout(finish, 380);
            });
          }

          async function runCell(cell, finalCh, delay) {
            await new Promise(function (r) {
              setTimeout(r, delay);
            });
            if (reduce || finalCh === '—') {
              setFull(cell, finalCh);
              return;
            }
            var current = DIGITS[Math.floor(Math.random() * 10)];
            setFull(cell, current);
            var spins = 4 + Math.floor(Math.random() * 3);
            for (var i = 0; i < spins; i++) {
              var next =
                i === spins - 1 ? finalCh : DIGITS[Math.floor(Math.random() * 10)];
              await flipOnce(cell, current, next);
              current = next;
            }
            if (current !== finalCh) await flipOnce(cell, current, finalCh);
          }

          function mount(el) {
            if (!el || el.dataset.flapReady === '1') return;
            if (!el.classList.contains('card-num')) return;
            var target = parseTarget(el.textContent);
            var chars = target ? target.split('') : ['—'];
            el.dataset.flapReady = '1';
            el.setAttribute('aria-label', target || '—');
            el.classList.add('is-flap');
            el.innerHTML =
              '<span class="flap-board">' + chars.map(cellHtml).join('') + '</span>';
            el.querySelectorAll('.flap-cell').forEach(function (cell, i) {
              runCell(cell, chars[i], 70 + i * 130);
            });
          }

          function boot() {
            document.querySelectorAll('.card-num[data-looks]').forEach(mount);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
          } else {
            boot();
          }
        })();
      </script>

      <h2 class="pages-title">
        Latest opens <span data-looks-recent-count>—</span>
      </h2>
      <p class="note">
        Each row is one real page open. Newest first — path, city, country, IP, referrer. City is
        Cloudflare IP geo (~60–80% right; VPN / mobile hubs can miss). Private for you. Open Home
        in another tab, refresh, and watch a row land.
      </p>
      <ol class="pages" data-looks-recent>
        <li class="empty">Open any public page in another tab, then refresh — a row shows here.</li>
      </ol>
      <script type="application/json" data-looks-recent-json>[]</script>
      <script is:inline>
        (function () {
          var dataEl = document.querySelector('[data-looks-recent-json]');
          var list = document.querySelector('ol[data-looks-recent]');
          if (!dataEl || !list) return;
          var rows;
          try {
            rows = JSON.parse(dataEl.textContent || '[]');
          } catch (err) {
            return;
          }
          if (!Array.isArray(rows) || !rows.length) return;
          if (list.querySelector('.looks-recent')) return;

          function esc(value) {
            return String(value)
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
          }
          function whenLabel(iso) {
            var at = new Date(iso);
            if (isNaN(at.getTime())) return '—';
            return new Intl.DateTimeFormat('en-GB', {
              timeZone: 'Europe/Berlin',
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
              hour12: false,
            }).format(at);
          }
          list.innerHTML = rows
            .map(function (row) {
              var path = row.path === '/' ? 'Home' : esc(row.path || '/');
              var href = esc(row.path || '/');
              var bits = [];
              if (row.city) bits.push(esc(row.city));
              if (row.country) bits.push(esc(row.country));
              if (row.ip) bits.push(esc(row.ip));
              if (row.from) bits.push(esc(row.from));
              var meta = bits.length
                ? '<span class="looks-recent-meta">' + bits.join(' · ') + '</span>'
                : '';
              return (
                '<li class="looks-recent">' +
                '<span class="looks-recent-main">' +
                '<a href="' +
                href +
                '">' +
                path +
                '</a>' +
                meta +
                '</span>' +
                '<span class="looks-recent-when">' +
                esc(whenLabel(row.t)) +
                '</span>' +
                '</li>'
              );
            })
            .join('');
          var countEl = document.querySelector('[data-looks-recent-count]');
          if (countEl) countEl.textContent = String(rows.length);
        })();
      </script>

      <h2 class="pages-title">14 days</h2>
      <p class="note">Berlin days. Column height ∝ opens. Max column = busiest day.</p>
      <ol class="looks-bars" data-looks-days>
        <li class="empty">Day bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">8 weeks</h2>
      <p class="note">Each column = 7 days. Compare this week to last.</p>
      <ol class="looks-bars" data-looks-weeks>
        <li class="empty">Week bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">12 months</h2>
      <p class="note">Berlin calendar months. Column height ∝ opens. Max column = busiest month.</p>
      <ol class="looks-bars" data-looks-months>
        <li class="empty">Month bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Years</h2>
      <ol class="pages" data-looks-years>
        <li class="empty">Years show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Pages</h2>
      <ol class="pages" data-looks-pages>
        <li class="empty">Open Home or a ride, then refresh this page.</li>
      </ol>

      <h2 class="pages-title">Cities</h2>
      <p class="note">
        From the visitor’s IP via Cloudflare geo — roughly <strong>60–80%</strong> right at city
        level (country is usually stronger). Think “this network looks like Chicago / Amsterdam,”
        not a GPS pin. VPN, corporate gateways, and mobile hubs can land on the wrong town. New
        opens only from now on.
      </p>
      <ol class="pages" data-looks-cities>
        <li class="empty">City shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Countries</h2>
      <p class="note">
        Same IP geo as cities, but country is typically more reliable than town (~90%+ in practice).
      </p>
      <ol class="pages" data-looks-countries>
        <li class="empty">Country shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Referrers</h2>
      <p class="note">
        Tap a name to open that site. Browsers often hide the exact post — you get the network, not
        the single link.
      </p>
      <ol class="pages" data-looks-from>
        <li class="empty">The site that sent them shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">
        Free members <span data-members-count>—</span>
      </h2>
      <p class="note">
        Private for you. Everyone who joined the free list, newest first. Names and emails stay off
        the public site.
      </p>
      <ol class="pages" data-members-list>
        <li class="empty">No free members yet. When someone joins, they show here.</li>
      </ol>

      <h2 class="pages-title">
        Postcards started <span data-postcard-shares-count>—</span>
      </h2>
      <p class="note">
        Private for you. Someone tapped Send this ride; they send it themselves. Newest first.
      </p>
      <ol class="pages" data-postcard-shares-list>
        <li class="empty">No postcards started yet. When someone taps Send this ride, it shows here.</li>
      </ol>
    </div>
  </section>
  <MemberDelete />
</BaseLayout>

<style>
  .looks {
    max-width: 46rem;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* One old airport strip — only this top row */
  .looks-board {
    margin: 1.75rem 0 2.25rem;
    padding: 0.55rem 0.55rem 0.7rem;
    border-radius: 0.2rem;
    border: 1px solid rgba(0, 0, 0, 0.85);
    background:
      linear-gradient(180deg, rgba(255, 220, 160, 0.06), transparent 28%),
      linear-gradient(180deg, #3a2f24 0%, #1a1510 42%, #100d0a 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 230, 180, 0.12),
      inset 0 -2px 0 rgba(0, 0, 0, 0.45),
      0 8px 22px rgba(0, 0, 0, 0.35);
  }

  .looks-board-mark {
    margin: 0 0 0.45rem 0.15rem;
    color: rgba(242, 226, 184, 0.55);
    font-family: 'Courier New', 'Lucida Console', ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .looks-board-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.35rem;
  }

  @media (max-width: 719px) {
    .looks-board-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .looks-bay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.45rem 0.3rem 0.55rem;
    border-radius: 0.12rem;
    border: 1px solid rgba(0, 0, 0, 0.55);
    background: linear-gradient(180deg, #221c16 0%, #14110d 100%);
    box-shadow: inset 0 1px 0 rgba(255, 220, 170, 0.05);
  }

  .looks-bay-label {
    margin: 0;
    color: #e6d3a2;
    font-family: 'Courier New', 'Lucida Console', ui-monospace, monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  .card-num {
    margin: 0;
    color: #f2e2b8;
    font-family: 'Courier New', 'Lucida Console', ui-monospace, monospace;
    font-size: clamp(1.7rem, 3.8vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .card-num.is-flap {
    letter-spacing: 0;
  }

  .flap-board {
    --flap-w: clamp(1.2rem, 2.6vw, 1.45rem);
    --flap-h: clamp(1.7rem, 3.8vw, 2.05rem);
    display: inline-flex;
    gap: 0.14rem;
    align-items: center;
    justify-content: center;
  }

  .flap-cell {
    position: relative;
    flex: 0 0 var(--flap-w);
    width: var(--flap-w);
    height: var(--flap-h);
    perspective: 600px;
    border-radius: 0.12rem;
    border: 1px solid rgba(0, 0, 0, 0.75);
    background: #0c0b09;
    box-shadow:
      0 0 0 1px rgba(180, 150, 100, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
    color: #f2e2b8;
    font-family: 'Courier New', 'Lucida Console', ui-monospace, monospace;
    font-size: calc(var(--flap-h) * 0.62);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .flap-cell::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    z-index: 6;
    height: 2px;
    margin-top: -1px;
    background: #050403;
    box-shadow: 0 1px 0 rgba(255, 230, 180, 0.05);
    pointer-events: none;
  }

  .flap-panel {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
    background: linear-gradient(180deg, #1c1914 0%, #12100c 100%);
  }

  .flap-top {
    top: 0;
    z-index: 1;
    border-radius: 0.1rem 0.1rem 0 0;
  }

  .flap-bottom {
    bottom: 0;
    z-index: 1;
    border-radius: 0 0 0.1rem 0.1rem;
    background: linear-gradient(180deg, #0e0c0a 0%, #17140f 100%);
  }

  .flap-glyph {
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--flap-h);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    letter-spacing: 0;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.65);
  }

  .flap-top .flap-glyph {
    top: 0;
  }

  .flap-bottom .flap-glyph {
    bottom: 0;
    top: auto;
  }

  .flap-hinge {
    position: absolute;
    left: 0;
    width: 100%;
    top: 0;
    height: 50%;
    z-index: 5;
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }

  .flap-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: linear-gradient(180deg, #242017 0%, #14110d 100%);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.35);
  }

  .flap-front .flap-glyph {
    top: 0;
  }

  .flap-back {
    transform: rotateX(180deg);
    background: linear-gradient(180deg, #0c0b09 0%, #1a1712 100%);
  }

  .flap-back .flap-glyph {
    bottom: 0;
    top: auto;
  }

  .flap-hinge.is-flipping {
    animation: looks-flap-flip 0.34s cubic-bezier(0.4, 0.05, 0.7, 1) forwards;
  }

  @keyframes looks-flap-flip {
    from {
      transform: rotateX(0deg);
    }
    to {
      transform: rotateX(-180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flap-hinge.is-flipping {
      animation: none;
    }
  }
</style>
