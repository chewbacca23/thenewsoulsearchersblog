---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberDelete from '../components/MemberDelete.astro';
---

<BaseLayout
  title="Looks"
  description="How many times people opened pages on The Soul Searchers."
  robots="noindex, nofollow"
>
  <section class="section">
    <div class="site-shell looks">
      <p class="eyebrow">Open counts</p>
      <h1 class="section-title">Looks</h1>
      <p class="section-lead">
        Private for you. Opens per page, day, week, and month — Berlin calendar. Latest opens keep
        path, place, IP, and referrer for the last 10 hits — not on the public site. Counts start
        after this Worker is live.
      </p>

      <div class="cards" role="group" aria-label="Summary counts">
        <article class="card">
          <p class="card-label">n<sub>day</sub></p>
          <p class="card-hint">Today</p>
          <p class="card-num" data-looks="today">—</p>
        </article>
        <article class="card">
          <p class="card-label">n<sub>7</sub></p>
          <p class="card-hint">Last 7 days</p>
          <p class="card-num" data-looks="week">—</p>
        </article>
        <article class="card">
          <p class="card-label">n<sub>month</sub></p>
          <p class="card-hint">This month</p>
          <p class="card-num" data-looks="month">—</p>
        </article>
        <article class="card">
          <p class="card-label">n<sub>year</sub></p>
          <p class="card-hint">This year</p>
          <p class="card-num" data-looks="year">—</p>
        </article>
        <article class="card">
          <p class="card-label">Σ</p>
          <p class="card-hint">All time</p>
          <p class="card-num" data-looks="total">—</p>
        </article>
      </div>

      <h2 class="pages-title">
        Latest opens <span data-looks-recent-count>—</span>
      </h2>
      <p class="note">
        Each row is one real page open. Newest first — path, city, country, IP, referrer. City is
        Cloudflare IP geo (~60–80% right; VPN / mobile hubs can miss). Private for you. Open Home
        in another tab, refresh, and watch a row land.
      </p>
      <ol class="pages" data-looks-recent>
        <li class="empty">Open any public page in another tab, then refresh — a row shows here.</li>
      </ol>
      <script type="application/json" data-looks-recent-json>[]</script>
      <script is:inline>
        (function () {
          var dataEl = document.querySelector('[data-looks-recent-json]');
          var list = document.querySelector('ol[data-looks-recent]');
          if (!dataEl || !list) return;
          var rows;
          try {
            rows = JSON.parse(dataEl.textContent || '[]');
          } catch (err) {
            return;
          }
          if (!Array.isArray(rows) || !rows.length) return;
          if (list.querySelector('.looks-recent')) return;

          function esc(value) {
            return String(value)
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
          }
          function whenLabel(iso) {
            var at = new Date(iso);
            if (isNaN(at.getTime())) return '—';
            return new Intl.DateTimeFormat('en-GB', {
              timeZone: 'Europe/Berlin',
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
              hour12: false,
            }).format(at);
          }
          list.innerHTML = rows
            .map(function (row) {
              var path = row.path === '/' ? 'Home' : esc(row.path || '/');
              var href = esc(row.path || '/');
              var bits = [];
              if (row.city) bits.push(esc(row.city));
              if (row.country) bits.push(esc(row.country));
              if (row.ip) bits.push(esc(row.ip));
              if (row.from) bits.push(esc(row.from));
              var meta = bits.length
                ? '<span class="looks-recent-meta">' + bits.join(' · ') + '</span>'
                : '';
              return (
                '<li class="looks-recent">' +
                '<span class="looks-recent-main">' +
                '<a href="' +
                href +
                '">' +
                path +
                '</a>' +
                meta +
                '</span>' +
                '<span class="looks-recent-when">' +
                esc(whenLabel(row.t)) +
                '</span>' +
                '</li>'
              );
            })
            .join('');
          var countEl = document.querySelector('[data-looks-recent-count]');
          if (countEl) countEl.textContent = String(rows.length);
        })();
      </script>

      <h2 class="pages-title">14 days</h2>
      <p class="note">Berlin days. Column height ∝ opens. Max column = busiest day.</p>
      <ol class="looks-bars" data-looks-days>
        <li class="empty">Day bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">8 weeks</h2>
      <p class="note">Each column = 7 days. Compare this week to last.</p>
      <ol class="looks-bars" data-looks-weeks>
        <li class="empty">Week bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">12 months</h2>
      <p class="note">Berlin calendar months. Column height ∝ opens. Max column = busiest month.</p>
      <ol class="looks-bars" data-looks-months>
        <li class="empty">Month bars show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Years</h2>
      <ol class="pages" data-looks-years>
        <li class="empty">Years show once people have opened the site.</li>
      </ol>

      <h2 class="pages-title">Pages</h2>
      <ol class="pages" data-looks-pages>
        <li class="empty">Open Home or a ride, then refresh this page.</li>
      </ol>

      <h2 class="pages-title">Cities</h2>
      <p class="note">
        From the visitor’s IP via Cloudflare geo — roughly <strong>60–80%</strong> right at city
        level (country is usually stronger). Think “this network looks like Chicago / Amsterdam,”
        not a GPS pin. VPN, corporate gateways, and mobile hubs can land on the wrong town. New
        opens only from now on.
      </p>
      <ol class="pages" data-looks-cities>
        <li class="empty">City shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Countries</h2>
      <p class="note">
        Same IP geo as cities, but country is typically more reliable than town (~90%+ in practice).
      </p>
      <ol class="pages" data-looks-countries>
        <li class="empty">Country shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">Referrers</h2>
      <p class="note">
        Tap a name to open that site. Browsers often hide the exact post — you get the network, not
        the single link.
      </p>
      <ol class="pages" data-looks-from>
        <li class="empty">The site that sent them shows after someone opens a page.</li>
      </ol>

      <h2 class="pages-title">
        Free members <span data-members-count>—</span>
      </h2>
      <p class="note">
        Private for you. Everyone who joined the free list, newest first. Names and emails stay off
        the public site.
      </p>
      <ol class="pages" data-members-list>
        <li class="empty">No free members yet. When someone joins, they show here.</li>
      </ol>

      <h2 class="pages-title">
        Postcards started <span data-postcard-shares-count>—</span>
      </h2>
      <p class="note">
        Private for you. Someone tapped Send this ride; they send it themselves. Newest first.
      </p>
      <ol class="pages" data-postcard-shares-list>
        <li class="empty">No postcards started yet. When someone taps Send this ride, it shows here.</li>
      </ol>
    </div>
  </section>
  <MemberDelete />
</BaseLayout>

<style>
  .looks {
    max-width: 46rem;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .cards {
    display: grid;
    gap: 0;
    margin: 1.75rem 0 2.25rem;
    border: 1px solid rgba(215, 224, 232, 0.16);
    background: rgba(8, 12, 17, 0.45);
  }

  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    padding: 0.95rem 1rem 1.05rem;
    border: 0;
    border-right: 1px solid rgba(215, 224, 232, 0.12);
    border-bottom: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 0;
    background: transparent;
  }

  @media (min-width: 720px) {
    .card:nth-child(5n) {
      border-right: 0;
    }

    .card {
      border-bottom: 0;
    }
  }

  @media (max-width: 719px) {
    .card:nth-child(2n) {
      border-right: 0;
    }

    .card:nth-child(n + 5) {
      border-bottom: 0;
    }
  }

  .card-label {
    margin: 0;
    color: var(--amber);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .card-label sub {
    font-size: 0.65em;
    bottom: -0.08em;
  }

  .card-hint {
    margin: 0.28rem 0 0;
    color: rgba(215, 224, 232, 0.55);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-num {
    margin: 0.55rem 0 0;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.65rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
</style>
