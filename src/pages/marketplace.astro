          offerBox.value = line;
          lastWare = line;
        }
        var stall = document.getElementById('pin-form');
        if (stall && stall.scrollIntoView) stall.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (offerBox) offerBox.focus();
