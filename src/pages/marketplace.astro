    function tgComposeIsOpen() {
      return (
        !!tgCompose &&
        !tgCompose.hidden &&
        tgCompose.classList.contains('is-open') &&
        !tgCompose.classList.contains('is-closing')
      );
    }

    function waComposeIsOpen() {
      return (
        !!waCompose &&
        !waCompose.hidden &&
        waCompose.classList.contains('is-open') &&
        !waCompose.classList.contains('is-closing')
      );
    }

    function openTgCompose() {
      if (!tgCompose) return;
      if (waComposeIsOpen()) closeWaCompose();
      if (tgComposeIsOpen()) {
        focusTgComposeForm();
        return;
      }
      if (tgComposeCloseTimer) {
        window.clearTimeout(tgComposeCloseTimer);
        tgComposeCloseTimer = 0;
      }
      tgCompose.classList.remove('is-closing');
      tgCompose.hidden = false;
      void tgCompose.offsetWidth;
      tgCompose.classList.add('is-open');
      document.documentElement.classList.add('tg-compose-open');
      showTgComposeError('');
      focusTgComposeForm();
    }

    function openWaCompose() {
      if (!waCompose) return;
      if (tgComposeIsOpen()) closeTgCompose();
      // Already open, just focus the form; don't restart as if closed.
      if (waComposeIsOpen()) {
        focusWaComposeForm();
        return;
      }
      if (waComposeCloseTimer) {
        window.clearTimeout(waComposeCloseTimer);
        waComposeCloseTimer = 0;
      }
      waCompose.classList.remove('is-closing');
      waCompose.hidden = false;
      // Force a paint so the open animation can restart after a fast reopen.
      void waCompose.offsetWidth;
      waCompose.classList.add('is-open');
      document.documentElement.classList.add('wa-compose-open');
      showWaComposeError('');
      focusWaComposeForm();
    }

