          }
          render(data);
          fillFormsFromMemory();
          showWelcomeBack();
          showCallsForYou();
        })
        .catch(function () {
          if (n < 2) {
            setTimeout(function () {
              load(n + 1);
            }, 400 * (n + 1));
            return;
          }
          writeCrowdSign(0);
          showError('The board could not load just now. Give it a second and refresh if the site was quiet.');
