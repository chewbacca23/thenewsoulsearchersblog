    function phoneDigitsForWa(raw) {
      var value = String(raw || '')
        .trim()
        .slice(0, 32);
      if (!value) return '';
      var digits = value.replace(/[^\d+]/g, '');
      var hasPlus = digits.charAt(0) === '+';
      var only = (hasPlus ? digits.slice(1) : digits).replace(/\D/g, '');
      if (only.length < 8 || only.length > 15) return '';
      return only;
    }

    function cleanTelegramHandle(raw) {
      var value = String(raw || '')
        .trim()
        .slice(0, 33);
      if (!value) return '';
      if (value.charAt(0) === '@') value = value.slice(1);
      value = value.trim();
      if (!/^[A-Za-z][A-Za-z0-9_]{4,31}$/.test(value)) return '';
      return value;
    }

    function telegramMeUrl(username) {
      var handle = cleanTelegramHandle(username);
      if (!handle) return '';
      return 'https://t.me/' + handle;
    }

    function waComposePrefill(name) {
      var who = String(name || '')
        .trim()
        .slice(0, 80);
      if (who) return 'Hey ' + who + ', from the Soul Searchers map.';
      return 'Hey from the Soul Searchers map.';
    }

    function waMeUrl(phone) {
      var digits = phoneDigitsForWa(phone);
      if (!digits) return '';
      return 'https://signal.me/#p/+' + digits;
    }

    function showTgComposeError(message) {
      if (!tgComposeError) return;
      if (!message) {
        tgComposeError.hidden = true;
        tgComposeError.textContent = '';
        return;
      }
      tgComposeError.hidden = false;
      tgComposeError.textContent = message;
    }

