      if (tgCompose && !tgCompose.hidden) {
        closeTgCompose();
        return;
      }
      if (waCompose && !waCompose.hidden) {
        closeWaCompose();
        return;
      }
      if (callToast && !callToast.hidden) {
        var waitingEsc = callsWaitingForMe();
        if (waitingEsc[0]) toastDismissedSig = callToastSignature(waitingEsc[0]);
        hideCallToast();
        return;
      }
      if (dockKey) {
        closeChatDock();
        return;
      }
      if (openKey) {
        openKey = '';
        render(lastPayload);
      }
    });

    if (welcomeBackOpen) {
      welcomeBackOpen.addEventListener('click', function () {
        var mem = readMemory();
        if (!mem.lastTalkKey) return;
        var person = personByKey(mem.lastTalkKey);
        if (!person) return;
        // Force open (do not toggle closed if already selected).
        openKey = person.key;
        rememberTalk(openKey, person.name);
        render(lastPayload);
        var me = selfKey();
        if (me && threadForPair(me, person.key)) {
          openChatDock(person.key);
        } else {
          openChatDock(person.key, { focus: true });
        }
        try {
          var mark =
            (typeof CSS !== 'undefined' && CSS.escape
              ? document.querySelector('.dot[data-open="' + CSS.escape(person.key) + '"]')
              : null) ||
            document.getElementById('group-open') ||
            document.getElementById('group');
          if (mark && mark.scrollIntoView) {
            mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } catch (err) {}
      });
    }

    if (callsForYouOpen) {
      callsForYouOpen.addEventListener('click', function () {
        var key = callsForYouOpen.getAttribute('data-open-call');
        if (!key) return;
        openCallFromToast(key);
      });
    }

    if (callToastOpen) {
      callToastOpen.addEventListener('click', function () {
        var key = callToastOpen.getAttribute('data-open-call') || toastPendingKey;
        if (!key) return;
        openCallFromToast(key);
      });
    }

    if (callToastDismiss) {
      callToastDismiss.addEventListener('click', function () {
        var waitingDismiss = callsWaitingForMe();
        if (waitingDismiss[0]) toastDismissedSig = callToastSignature(waitingDismiss[0]);
        hideCallToast();
      });
    }

    if (cookieNoteOk) {
      cookieNoteOk.addEventListener('click', function () {
        dismissCookieNote();
      });
    }

    var wareButtons = document.querySelectorAll('.ware');
    var offerBox = document.querySelector('#pin-form textarea[name="note"]');
    var lastWare = '';
    wareButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var line = button.getAttribute('data-offer') || '';
        wareButtons.forEach(function (other) {
          other.classList.toggle('is-on', other === button);
        });
