      })
        .then(function (res) {
          return res.json().then(function (body) {
            return { res: res, body: body };
          });
        })
        .then(function (out) {
          if (out.res.ok && out.body.ok) {
            var talkPerson = personByKey(toKey);
            rememberSelf(fields.name, fields.place, fields.email);
            rememberTalk(toKey, talkPerson && talkPerson.name);
            markCallsSeen();
            dockKey = toKey;
            render(out.body);
            renderChatDock();
            startDockPoll();
            fillFormsFromMemory();
            showCallsForYou();
            if (chatDockForm) {
              var msgEl = chatDockForm.elements.namedItem('message');
              if (msgEl) msgEl.value = '';
            }
            if (onDone) onDone(true);
            return;
          }
          showError((out.body && out.body.error) || 'Could not send that call.');
          if (onDone) onDone(false);
        })
        .catch(function () {
          showError('Could not send that call.');
          if (onDone) onDone(false);
        });
    }

