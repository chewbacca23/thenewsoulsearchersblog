      '</svg>';
    var waMarkSvg =
      '<svg viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">' +
      '<path fill="currentColor" d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.23 8.24-1.4 0-2.79-.37-4.01-1.06l-.29-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 0 1-1.25-4.48c0-4.54 3.7-8.24 8.23-8.24zm4.52 10.52c-.2-.1-1.18-.58-1.36-.65-.18-.06-.32-.1-.45.1-.13.2-.5.65-.62.78-.11.13-.23.15-.43.05-.2-.1-.84-.31-1.6-.99-.59-.53-.99-1.18-1.1-1.38-.12-.2-.01-.3.09-.4.09-.09.2-.23.3-.35.1-.12.13-.2.2-.33.07-.13.03-.25-.02-.35-.05-.1-.45-1.08-.62-1.47-.16-.39-.33-.33-.45-.34h-.38c-.13 0-.34.05-.52.25-.18.2-.68.67-.68 1.62 0 .96.7 1.87.8 2 .1.13 1.37 2.1 3.32 2.94.46.2.83.32 1.11.41.47.15.89.13 1.23.08.37-.06 1.18-.48 1.34-.95.17-.47.17-.87.12-.95-.05-.08-.18-.13-.38-.23z"/>' +
      '</svg>';
    var canModerate = false;
    var lastPayload = null;
    var openKey = '';
    var dockKey = '';
    var dockPollTimer = null;
    var DOCK_POLL_MS = 8000;
    var chatDock = document.getElementById('chat-dock');
    var chatDockName = document.getElementById('chat-dock-name');
    var chatDockThread = document.getElementById('chat-dock-thread');
    var chatDockEmpty = document.getElementById('chat-dock-empty');
    var chatDockForm = document.getElementById('chat-dock-form');
    var chatDockClose = document.getElementById('chat-dock-close');
    var chatDockMute = document.getElementById('chat-dock-mute');
    var chatDockPing = document.getElementById('chat-dock-ping');
    var chatDockSend = document.getElementById('chat-dock-send');
    var chatDockMsgLabel = document.getElementById('chat-dock-msg-label');
    var MEMORY_KEY = 'soul-marketplace-memory';
    var COOKIE_NAME = 'soul_on_map';
    var COOKIE_NOTE_KEY = 'soul-marketplace-cookie-note';
    var NOTIFY_ASKED_KEY = 'soul-call-notify-asked';
    var didWelcome = false;
    var NEAR_MAP_DIST = 14;
    var dockSeenMsgId = '';
    var dockSeenMsgAt = '';
    var dockSeenBootstrapped = false;
    var dockMuteBing = false;
    var dockAudioCtx = null;
    var notifyPermissionAsked = false;
    var toastShownSig = '';
    var toastDismissedSig = '';
    var toastPendingKey = '';

    function readMemory() {
      try {
        var raw = localStorage.getItem(MEMORY_KEY);
        if (!raw) return {};
        var data = JSON.parse(raw);
        return data && typeof data === 'object' ? data : {};
      } catch (err) {
        return {};
      }
    }

    function writeMemory(patch) {
      var next = Object.assign({}, readMemory(), patch || {}, { at: new Date().toISOString() });
      try {
        localStorage.setItem(MEMORY_KEY, JSON.stringify(next));
      } catch (err) {}
      try {
        document.cookie = COOKIE_NAME + '=1; path=/; max-age=34560000; SameSite=Lax';
      } catch (err2) {}
      return next;
    }

    function hasOnMapCookie() {
      try {
        return document.cookie.split(';').some(function (part) {
          return part.trim().indexOf(COOKIE_NAME + '=') === 0;
        });
      } catch (err) {
        return false;
      }
    }

    function cookieNoteSeen() {
      try {
        return localStorage.getItem(COOKIE_NOTE_KEY) === 'ok';
      } catch (err) {
        return false;
      }
    }

    function showCookieNote() {
      if (!cookieNote) return;
      cookieNote.hidden = cookieNoteSeen();
    }

    function dismissCookieNote() {
      try {
        localStorage.setItem(COOKIE_NOTE_KEY, 'ok');
      } catch (err) {}
      if (cookieNote) cookieNote.hidden = true;
    }

    function rememberSelf(name, place, email, phone) {
      var patch = {};
      if (name) patch.name = String(name).trim().slice(0, 80);
      if (place) patch.place = String(place).trim().slice(0, 80);
      if (email) patch.email = String(email).trim().slice(0, 200);
      if (phone) patch.phone = String(phone).trim().slice(0, 32);
      return writeMemory(patch);
    }

    function rememberTalk(key, name) {
      if (!key) return readMemory();
      return writeMemory({
        lastTalkKey: String(key),
        lastTalkName: String(name || key).trim().slice(0, 80),
      });
    }

    function fillFormsFromMemory() {
      var mem = readMemory();
      if (pinForm) {
        if (mem.name && pinForm.elements.namedItem('name')) {
          pinForm.elements.namedItem('name').value = mem.name;
        }
        if (mem.place && pinForm.elements.namedItem('place')) {
          pinForm.elements.namedItem('place').value = mem.place;
        }
        if (mem.email && pinForm.elements.namedItem('email')) {
          pinForm.elements.namedItem('email').value = mem.email;
        }
        if (mem.phone && pinForm.elements.namedItem('phone')) {
          pinForm.elements.namedItem('phone').value = mem.phone;
        }
      }
      document.querySelectorAll('.write-form, .call-form').forEach(function (form) {
        if (mem.name && form.elements.namedItem('name')) {
          form.elements.namedItem('name').value = mem.name;
        }
        if (mem.email && form.elements.namedItem('email')) {
          form.elements.namedItem('email').value = mem.email;
        }
        if (mem.place && form.elements.namedItem('place')) {
          form.elements.namedItem('place').value = mem.place;
        }
      });
      if (chatDockForm) {
        var nameEl = chatDockForm.elements.namedItem('name');
        var emailEl = chatDockForm.elements.namedItem('email');
        var placeEl = chatDockForm.elements.namedItem('place');
        if (mem.name && nameEl && !String(nameEl.value || '').trim()) nameEl.value = mem.name;
        if (mem.email && emailEl && !String(emailEl.value || '').trim()) emailEl.value = mem.email;
        if (mem.place && placeEl && !String(placeEl.value || '').trim()) placeEl.value = mem.place;
      }
    }

    function selfKey() {
      var mem = readMemory();
      return String(mem.name || '')
        .trim()
        .toLowerCase()
        .slice(0, 80);
    }

    function personHomePlace(person) {
      if (!person) return '';
      var stalls = person.stalls || [];
      for (var i = 0; i < stalls.length; i += 1) {
        if (stalls[i].place) return String(stalls[i].place);
      }
      var offers = person.offers || [];
      for (var j = 0; j < offers.length; j += 1) {
        if (offers[j].place) return String(offers[j].place);
      }
      return '';
    }

    function normalizePlaceClient(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/ß/g, 'ss')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    function areNearClient(a, b) {
      if (!a || !b || a.key === b.key) return false;
      if ((a.neighborKeys || []).indexOf(b.key) !== -1) return true;
      if ((b.neighborKeys || []).indexOf(a.key) !== -1) return true;
      if (typeof a.cluster === 'number' && typeof b.cluster === 'number' && a.cluster === b.cluster) {
        return true;
      }
      var placeA = normalizePlaceClient(personHomePlace(a));
      var placeB = normalizePlaceClient(personHomePlace(b));
      if (placeA && placeB && placeA === placeB) return true;
      if (
        Number.isFinite(Number(a.x)) &&
        Number.isFinite(Number(a.y)) &&
        Number.isFinite(Number(b.x)) &&
        Number.isFinite(Number(b.y))
      ) {
        var dx = Number(a.x) - Number(b.x);
        var dy = Number(a.y) - Number(b.y);
        if (Math.sqrt(dx * dx + dy * dy) <= NEAR_MAP_DIST) return true;
      }
      return false;
    }

    function canCallClient(toPerson) {
      if (!toPerson) return false;
      var mem = readMemory();
      var meKey = selfKey();
      if (meKey && meKey === toPerson.key) return false;
      var people = peopleFrom(lastPayload);
      var me = meKey ? people.find(function (row) { return row.key === meKey; }) : null;
      if (me) return areNearClient(me, toPerson);
      var place = normalizePlaceClient(mem.place || '');
      if (!place) return false;
      var toPlace = normalizePlaceClient(personHomePlace(toPerson));
      if (place && toPlace && place === toPlace) return true;
      var aTokens = place.split(' ').filter(Boolean);
      var bTokens = toPlace.split(' ').filter(Boolean);
      return aTokens.some(function (token) {
        return token.length > 3 && bTokens.indexOf(token) !== -1;
      });
    }

    function callPairKey(a, b) {
      var left = String(a || '').toLowerCase();
      var right = String(b || '').toLowerCase();
      if (!left || !right || left === right) return '';
      return left < right ? left + '|' + right : right + '|' + left;
    }

    function threadForPair(aKey, bKey) {
      var pair = callPairKey(aKey, bKey);
      if (!pair || !lastPayload || !lastPayload.calls) return null;
      for (var i = 0; i < lastPayload.calls.length; i += 1) {
        if (lastPayload.calls[i].id === pair) return lastPayload.calls[i];
      }
      return null;
    }

    function callsWaitingForMe() {
      var me = selfKey();
      if (!me || !lastPayload || !Array.isArray(lastPayload.calls)) return [];
      var mem = readMemory();
      var seenAt = mem.callsSeenAt || '';
      var waiting = [];
      lastPayload.calls.forEach(function (thread) {
        if (!thread || (thread.aKey !== me && thread.bKey !== me)) return;
        var messages = thread.messages || [];
        if (!messages.length) return;
        var last = messages[messages.length - 1];
        if (!last || last.fromKey === me) return;
        if (seenAt && last.at && String(last.at) <= String(seenAt)) return;
        var otherKey = thread.aKey === me ? thread.bKey : thread.aKey;
        waiting.push({
          otherKey: otherKey,
          fromName: last.fromName,
          text: last.text,
          at: last.at,
        });
      });
      waiting.sort(function (a, b) {
        return String(b.at || '').localeCompare(String(a.at || ''));
      });
      return waiting;
    }

    function markCallsSeen() {
      writeMemory({ callsSeenAt: new Date().toISOString() });
    }

    function callToastSignature(row) {
      if (!row) return '';
      return String(row.otherKey || '') + '|' + String(row.at || '') + '|' + String(row.text || '').slice(0, 40);
    }

    function hideCallToast() {
      if (!callToast) return;
      callToast.hidden = true;
      callToast.classList.remove('is-in');
      toastPendingKey = '';
      if (callToastOpen) callToastOpen.removeAttribute('data-open-call');
      if (callToastNote) {
        callToastNote.hidden = true;
        callToastNote.textContent = '';
      }
    }

    function showCallToast(row, options) {
      if (!callToast || !row || !row.otherKey) return;
      var opts = options || {};
      var sig = callToastSignature(row);
      if (toastDismissedSig && toastDismissedSig === sig) return;
      // Dock already open on this brother, bing/nudge owns the moment.
      if (dockKey && dockKey === row.otherKey && !opts.force) {
        hideCallToast();
        return;
      }
      var name = String(row.fromName || 'A brother').trim() || 'A brother';
      if (callToastTitle) {
        callToastTitle.textContent = name + ' is calling you';
      }
      if (callToastNote) {
        var snippet = String(row.text || '').trim();
        if (snippet) {
          callToastNote.hidden = false;
          callToastNote.textContent =
            '“' + snippet.slice(0, 90) + (snippet.length > 90 ? '…' : '') + '”';
        } else {
          callToastNote.hidden = true;
          callToastNote.textContent = '';
        }
      }
      if (callToastOpen) {
        callToastOpen.setAttribute('data-open-call', row.otherKey);
        callToastOpen.textContent = 'Open with ' + name;
      }
      toastPendingKey = row.otherKey;
      var wasHidden = callToast.hidden;
      callToast.hidden = false;
      if (wasHidden || toastShownSig !== sig) {
        callToast.classList.remove('is-in');
        void callToast.offsetWidth;
        if (!prefersReducedMotion()) callToast.classList.add('is-in');
        if (toastShownSig !== sig) {
          toastShownSig = sig;
          if (opts.bing !== false) playSoftBing();
        }
      }
    }

    function syncCallToast(waiting) {
      var rows = waiting || callsWaitingForMe();
      if (!rows.length) {
        hideCallToast();
        return;
      }
      showCallToast(rows[0], { bing: toastShownSig !== callToastSignature(rows[0]) });
    }

    function openCallFromToast(key) {
      if (!key) return;
      var person = personByKey(key);
      openKey = key;
      rememberTalk(key, (person && person.name) || key);
      markCallsSeen();
      hideCallToast();
      toastDismissedSig = '';
      toastShownSig = '';
      render(lastPayload);
      openChatDock(key, { focus: true, allowMissing: !person });
      showCallsForYou();
      try {
        var mark =
          (typeof CSS !== 'undefined' && CSS.escape
            ? document.querySelector('.dot[data-open="' + CSS.escape(key) + '"]')
            : null) ||
          document.getElementById('group-open') ||
          document.getElementById('group');
        if (mark && mark.scrollIntoView) {
          mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch (err) {}
    }

    function showCallsForYou() {
      if (!callsForYou || !callsForYouText) return;
      var waiting = callsWaitingForMe();
      if (!waiting.length) {
        callsForYou.hidden = true;
        if (callsForYouOpen) callsForYouOpen.hidden = true;
        syncCallToast(waiting);
        return;
      }
      var first = waiting[0];
      if (waiting.length === 1) {
        callsForYouText.textContent =
          (first.fromName || 'A brother') +
          ' called upon you' +
          (first.text ? ': “' + String(first.text).slice(0, 80) + (first.text.length > 80 ? '…' : '') + '”' : '.');
      } else {
        callsForYouText.textContent =
          waiting.length + ' souls called upon you. Open the latest when you are ready.';
      }
      callsForYou.hidden = false;
      if (callsForYouOpen) {
        callsForYouOpen.hidden = false;
        callsForYouOpen.textContent = 'Open ' + (first.fromName || 'them');
        callsForYouOpen.setAttribute('data-open-call', first.otherKey || '');
      }
      syncCallToast(waiting);
    }

    function personByKey(key) {
      if (!key || !lastPayload) return null;
      var people = peopleFrom(lastPayload);
      for (var i = 0; i < people.length; i += 1) {
        if (people[i].key === key) return people[i];
      }
      return null;
    }

    function personKeyForHook(hookId) {
      if (!hookId || !lastPayload) return '';
      var people = peopleFrom(lastPayload);
      for (var i = 0; i < people.length; i += 1) {
        var stalls = people[i].stalls || [];
        for (var s = 0; s < stalls.length; s += 1) {
          if (stalls[s].id === hookId) return people[i].key;
        }
      }
      return '';
    }

    function showWelcomeBack() {
      if (!welcomeBack || !welcomeBackText || didWelcome) return;
      var mem = readMemory();
      var known =
        !!(mem.name || mem.place || mem.email || mem.phone || mem.lastTalkKey) || hasOnMapCookie();
      if (!known) {
        welcomeBack.hidden = true;
        if (welcomeBackOpen) welcomeBackOpen.hidden = true;
        return;
      }
      didWelcome = true;
      var person = mem.lastTalkKey ? personByKey(mem.lastTalkKey) : null;
      var who = (person && person.name) || mem.lastTalkName || '';
      var hello = mem.name
        ? 'Always a wonderful day, brother. Welcome back, ' + mem.name + '.'
        : 'Always a wonderful day, brother. Welcome back.';
      if (who) {
        welcomeBackText.textContent =
          hello + ' Your last conversation was with ' + who + ', open them when you are ready.';
      } else if (mem.place) {
        welcomeBackText.textContent =
          hello + ' Your place on the map still remembers ' + mem.place + '.';
      } else {
        welcomeBackText.textContent = hello + ' Good to see you on the map again.';
      }
      welcomeBack.hidden = false;
      if (welcomeBackOpen) {
        if (person) {
          welcomeBackOpen.hidden = false;
          welcomeBackOpen.textContent = 'Open ' + (person.name || 'them');
        } else {
          welcomeBackOpen.hidden = true;
        }
      }
    }

    function writeCrowdSign(n) {
      var count = Math.max(0, Number(n) || 0);
      if (signNum) signNum.textContent = String(count);
      if (signUnit) {
        signUnit.textContent = count === 1 ? 'rider standing' : 'riders standing';
      }
      if (signLine) {
        signLine.textContent =
          count === 0
            ? 'Be the first. Open a stall, show up for a ride, make coming back a habit.'
            : count === 1
              ? 'One soul is already here. Stand with them, rides get easier when you come back.'
              : count +
                ' souls already here. Come for the rides. Make showing up a habit.';
      }
      if (signRoot) {
        signRoot.classList.toggle('has-crowd', count > 0);
        signRoot.setAttribute('data-count', String(count));
      }
    }

    function showError(text) {
      if (!errorBox) return;
      errorBox.textContent = text || 'Could not do that just now.';
      errorBox.hidden = false;
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
    }

    function esc(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function flatten(hooks) {
      var cards = [];
      (hooks || []).forEach(function (hook) {
        cards.push({
          kind: 'stall',
          id: hook.id,
          hookId: hook.id,
          name: hook.name,
          place: hook.place,
          note: hook.note,
          at: hook.at,
          offerCount: (hook.offers || []).length,
        });
        (hook.offers || []).forEach(function (offer) {
          cards.push({
            kind: 'offer',
            id: offer.id,
            hookId: hook.id,
            name: offer.name,
            place: hook.place,
            forName: hook.name,
            note: offer.note,
            at: offer.at,
          });
        });
      });
      cards.sort(function (a, b) {
        return String(b.at || '').localeCompare(String(a.at || ''));
      });
      return cards;
    }

    function cardsFrom(payload) {
      if (payload && payload.market) return payload.market;
      return flatten(payload && payload.hooks);
    }

    function writeForm(hookId) {
      return (
        '<form class="write-form" hidden data-for="' +
        esc(hookId) +
        '">' +
        '<label><span>A name, any name</span><input type="text" name="name" required maxlength="80" /></label>' +
        '<label><span>Your offer</span><textarea name="message" rows="3" required maxlength="2000"></textarea></label>' +
        '<label><span>Email, optional</span><input type="email" name="email" maxlength="200" /></label>' +
        '<label class="hp" aria-hidden="true"><span>Fax</span><input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" /></label>' +
        '<button class="btn btn-primary" type="submit">Leave offer</button>' +
        '</form>'
      );
    }

    function callForm(toKey) {
      return (
        '<form class="call-form" hidden data-call="' +
        esc(toKey) +
        '">' +
        '<label><span>A name, any name</span><input type="text" name="name" required maxlength="80" /></label>' +
        '<label><span>Your place, so we know you are near</span><input type="text" name="place" maxlength="80" placeholder="Berlin outskirts, Kreuzberg, Nice…" /></label>' +
        '<label><span>Call upon them</span><textarea name="message" rows="2" required maxlength="500" placeholder="Brother, coffee before the climb?"></textarea></label>' +
        '<label><span>Email, optional, stays off the page</span><input type="email" name="email" maxlength="200" /></label>' +
        '<label class="hp" aria-hidden="true"><span>Fax</span><input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" /></label>' +
        '<button class="btn btn-primary" type="submit">Send call upon</button>' +
        '</form>'
      );
    }

    function renderCallThread(person) {
      var me = selfKey();
      if (!me || !person) return '';
      var thread = threadForPair(me, person.key);
      if (!thread || !(thread.messages || []).length) return '';
      var rows = (thread.messages || [])
          .map(function (msg) {
            var mine = msg.fromKey === me;
            return (
              '<li class="call-msg' +
              (mine ? ' is-mine' : ' is-theirs') +
              '">' +
              '<p class="call-msg-from">' +
              esc(mine ? 'You' : msg.fromName) +
              '</p>' +
              '<p class="call-msg-text">' +
              esc(msg.text) +
              '</p>' +
              '</li>'
            );
          })
          .join('');
      return '<ol class="call-thread" aria-label="Call upon thread">' + rows + '</ol>';
    }

    function stopDockPoll() {
      if (dockPollTimer) {
        clearInterval(dockPollTimer);
        dockPollTimer = null;
      }
    }

    function startDockPoll() {
      // Always poll so inbound Call upon toasts land even with the dock closed.
      if (dockPollTimer) return;
      dockPollTimer = setInterval(function () {
        loadQuiet();
      }, DOCK_POLL_MS);
    }

    function prefersReducedMotion() {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (err) {
        return false;
      }
    }

    function seedDockSeen(messages) {
      var last = messages && messages.length ? messages[messages.length - 1] : null;
      dockSeenMsgId = last ? String(last.id || '') : '';
      dockSeenMsgAt = last ? String(last.at || '') : '';
    }

    function advanceDockSeen(messages) {
      if (!messages || !messages.length) return;
      var last = messages[messages.length - 1];
      dockSeenMsgId = String(last.id || '');
      dockSeenMsgAt = String(last.at || '');
    }

    function isNewerThanSeen(msg) {
      if (!msg) return false;
      var id = String(msg.id || '');
      var at = String(msg.at || '');
      if (!dockSeenMsgId && !dockSeenMsgAt) return true;
      if (dockSeenMsgId && id && id === dockSeenMsgId) return false;
      if (dockSeenMsgAt && at) {
        if (at < dockSeenMsgAt) return false;
        if (at === dockSeenMsgAt && dockSeenMsgId && id && id <= dockSeenMsgId) return false;
      } else if (dockSeenMsgId && id && id <= dockSeenMsgId) {
        return false;
      }
      return true;
    }

    function playSoftBing() {
      if (dockMuteBing) return;
      try {
        var Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        if (!dockAudioCtx) dockAudioCtx = new Ctx();
        var ctx = dockAudioCtx;
        if (ctx.state === 'suspended') {
          ctx.resume().catch(function () {});
        }
        var now = ctx.currentTime;
        var gain = ctx.createGain();
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.045, now + 0.018);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);
        gain.connect(ctx.destination);

        var osc = ctx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(660, now);
        osc.frequency.exponentialRampToValueAtTime(528, now + 0.22);
        osc.connect(gain);
        osc.start(now);
        osc.stop(now + 0.34);

        var osc2 = ctx.createOscillator();
        var gain2 = ctx.createGain();
        gain2.gain.setValueAtTime(0.0001, now + 0.04);
        gain2.gain.exponentialRampToValueAtTime(0.022, now + 0.07);
        gain2.gain.exponentialRampToValueAtTime(0.0001, now + 0.38);
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(990, now + 0.04);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.04);
        osc2.stop(now + 0.4);
      } catch (err) {}
    }

    function nudgeChatDock() {
      if (!chatDock) return;
      chatDock.classList.remove('is-nudging');
      if (chatDockPing) {
        chatDockPing.hidden = false;
        chatDockPing.classList.remove('is-flash');
      }
      void chatDock.offsetWidth;
      if (!prefersReducedMotion()) {
        chatDock.classList.add('is-nudging');
      }
      if (chatDockPing) {
        chatDockPing.classList.add('is-flash');
      }
      window.setTimeout(function () {
        if (chatDock) chatDock.classList.remove('is-nudging');
        if (chatDockPing) {
          chatDockPing.classList.remove('is-flash');
          chatDockPing.hidden = true;
        }
      }, prefersReducedMotion() ? 900 : 700);
    }

    function maybeAskNotifyPermission() {
      if (notifyPermissionAsked) return;
      if (typeof Notification === 'undefined') return;
      if (Notification.permission !== 'default') return;
      try {
        if (localStorage.getItem(NOTIFY_ASKED_KEY) === '1') {
          notifyPermissionAsked = true;
          return;
        }
      } catch (err) {}
      notifyPermissionAsked = true;
      try {
        localStorage.setItem(NOTIFY_ASKED_KEY, '1');
      } catch (err2) {}
      try {
        Notification.requestPermission().catch(function () {});
      } catch (err3) {}
    }

    function softBackgroundNotify(fromName, text) {
      if (typeof document === 'undefined' || !document.hidden) return;
      if (typeof Notification === 'undefined') return;
      if (Notification.permission !== 'granted') return;
      try {
        var note = new Notification('Call upon, ' + String(fromName || 'someone'), {
          body: String(text || 'A short reply landed.').slice(0, 120),
          silent: true,
          tag: 'soul-call-upon-' + String(dockKey || 'thread'),
        });
        window.setTimeout(function () {
          try {
            note.close();
          } catch (err) {}
        }, 4500);
      } catch (err2) {}
    }

    function noticeOtherReply(msg) {
      if (!msg) return;
      playSoftBing();
      nudgeChatDock();
      softBackgroundNotify(msg.fromName, msg.text);
    }

    function detectOtherReplies(messages, me) {
      if (!dockKey || !me || !messages || !messages.length) return;
      if (!dockSeenBootstrapped) {
        seedDockSeen(messages);
        dockSeenBootstrapped = true;
        return;
      }
      var fresh = [];
      for (var i = 0; i < messages.length; i += 1) {
        var msg = messages[i];
        if (!msg || msg.fromKey === me) continue;
        if (isNewerThanSeen(msg)) fresh.push(msg);
      }
      advanceDockSeen(messages);
      if (!fresh.length) return;
      noticeOtherReply(fresh[fresh.length - 1]);
    }

    function syncMuteButton() {
      if (!chatDockMute) return;
      chatDockMute.setAttribute('aria-pressed', dockMuteBing ? 'true' : 'false');
      chatDockMute.setAttribute(
        'aria-label',
        dockMuteBing ? 'Unmute reply sound' : 'Mute reply sound',
      );
      chatDockMute.title = dockMuteBing ? 'Unmute reply sound' : 'Mute reply sound';
      var onIcon = chatDockMute.querySelector('.chat-dock-mute-on');
      var offIcon = chatDockMute.querySelector('.chat-dock-mute-off');
      if (onIcon) onIcon.hidden = dockMuteBing;
      if (offIcon) offIcon.hidden = !dockMuteBing;
      if (chatDock) chatDock.classList.toggle('is-muted', dockMuteBing);
    }

    function closeChatDock() {
      dockKey = '';
      dockSeenMsgId = '';
      dockSeenMsgAt = '';
      dockSeenBootstrapped = false;
      if (chatDock) {
        chatDock.hidden = true;
        chatDock.classList.remove('is-nudging');
      }
      if (chatDockPing) {
        chatDockPing.hidden = true;
        chatDockPing.classList.remove('is-flash');
      }
      if (chatDockForm) {
        chatDockForm.reset();
        fillFormsFromMemory();
      }
      // Keep board poll alive for inbound call toasts.
      startDockPoll();
      showCallsForYou();
    }

    function renderChatDock() {
      if (!chatDock || !dockKey) {
        if (chatDock) chatDock.hidden = true;
        return;
      }
      var person = personByKey(dockKey);
      var me = selfKey();
      var partnerName =
        (person && person.name) ||
        readMemory().lastTalkName ||
        dockKey;
      if (chatDockName) chatDockName.textContent = partnerName;
      var thread = me ? threadForPair(me, dockKey) : null;
      var messages = (thread && thread.messages) || [];
      var hasThread = messages.length > 0;
      detectOtherReplies(messages, me);
      if (chatDockThread) {
        chatDockThread.innerHTML = messages
          .map(function (msg) {
            var mine = msg.fromKey === me;
            return (
              '<li class="call-msg' +
              (mine ? ' is-mine' : ' is-theirs') +
              '">' +
              '<p class="call-msg-from">' +
              esc(mine ? 'You' : msg.fromName) +
              '</p>' +
              '<p class="call-msg-text">' +
              esc(msg.text) +
              '</p>' +
              '</li>'
            );
          })
          .join('');
        chatDockThread.hidden = !hasThread;
        if (hasThread) {
          try {
            chatDockThread.scrollTop = chatDockThread.scrollHeight;
          } catch (err) {}
        }
      }
      if (chatDockEmpty) chatDockEmpty.hidden = hasThread;
      if (chatDock) {
        chatDock.hidden = false;
        chatDock.classList.toggle('has-thread', hasThread);
        chatDock.setAttribute('data-partner', dockKey);
      }
      if (chatDockMsgLabel) {
        chatDockMsgLabel.textContent = hasThread ? 'Your reply' : 'Call upon them';
      }
      if (chatDockSend) {
        chatDockSend.textContent = hasThread ? 'Send reply' : 'Send call upon';
      }
      var placeField = chatDockForm && chatDockForm.querySelector('.chat-dock-field-place');
      if (placeField) placeField.hidden = hasThread;
      var msgArea = chatDockForm && chatDockForm.elements.namedItem('message');
      if (msgArea) {
        msgArea.setAttribute(
          'placeholder',
          hasThread ? 'A short reply, brother…' : 'Brother, coffee before the climb?',
        );
      }
      fillFormsFromMemory();
      syncMuteButton();
    }

    function openChatDock(key, options) {
      var opts = options || {};
      if (!key) return;
      var person = personByKey(key);
      if (!person && !opts.allowMissing) return;
      dockKey = key;
      dockSeenMsgId = '';
      dockSeenMsgAt = '';
      dockSeenBootstrapped = false;
      rememberTalk(key, (person && person.name) || key);
      if (meNeedsMark(key)) markCallsSeen();
      var me = selfKey();
      var thread = me ? threadForPair(me, key) : null;
      seedDockSeen((thread && thread.messages) || []);
      dockSeenBootstrapped = true;
      renderChatDock();
      startDockPoll();
      maybeAskNotifyPermission();
      if (opts.focus !== false && chatDockForm) {
        try {
          var msg = chatDockForm.elements.namedItem('message');
          if (msg && msg.focus) msg.focus();
        } catch (err) {}
      }
      showCallsForYou();
    }

    function meNeedsMark(otherKey) {
      var waiting = callsWaitingForMe();
      return waiting.some(function (row) {
        return row.otherKey === otherKey;
      });
    }

    function loadQuiet() {
      fetch('/api/hooks', { headers: { accept: 'application/json' } })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.ok) return;
          canModerate = !!data.canModerate;
          lastPayload = data;
          renderGroup(lastPayload);
          if (list) {
            var cards = cardsFrom(lastPayload);
            list.innerHTML = cards.length
              ? cards.map(renderCard).join('')
              : '<li class="empty">The floor is empty. Open the first stall.</li>';
          }
          if (dockKey) renderChatDock();
          showCallsForYou();
        })
        .catch(function () {});
    }

    var FRESH_MS = 5 * 24 * 60 * 60 * 1000;

    function isFresh(at) {
      var stamp = Date.parse(String(at || ''));
      if (!stamp) return false;
      var age = Date.now() - stamp;
      return age >= 0 && age < FRESH_MS;
    }

    function personIsFresh(person) {
      var bits = (person.stalls || []).concat(person.offers || []);
      return bits.some(function (bit) {
        return isFresh(bit.at);
      });
    }

    function renderCard(card) {
      var isStall = card.kind !== 'offer';
      var fresh = isFresh(card.at);
      var hookId = card.hookId || card.id;
      var remove =
        canModerate && isStall
          ? '<button type="button" class="hook-remove" data-remove="' +
            esc(hookId) +
            '">Take down</button>'
          : '';
      var kind = isStall ? 'Stall' : 'Offer';
      var forLine = !isStall && card.forName
        ? '<p class="card-for">for ' + esc(card.forName) + '</p>'
        : isStall && card.offerCount
          ? '<p class="card-for">' +
            card.offerCount +
            (card.offerCount === 1 ? ' offer on the floor' : ' offers on the floor') +
            '</p>'
          : '';
      return (
        '<li class="card card-' +
        (isStall ? 'stall' : 'offer') +
        (fresh ? ' is-fresh' : '') +
        '" data-id="' +
        esc(card.id) +
        '">' +
        (fresh ? '<p class="card-fresh">New</p>' : '') +
        '<p class="card-kind">' +
        kind +
        '</p>' +
        '<p class="hook-place">' +
        esc(card.place) +
        '</p>' +
        '<h2 class="hook-name">' +
        esc(card.name) +
        '</h2>' +
        forLine +
        '<p class="hook-note">' +
        esc(card.note) +
        '</p>' +
        '<button type="button" class="btn btn-ghost hook-write" data-write="' +
        esc(hookId) +
        '">' +
        (isStall ? 'Make an offer' : 'Offer on that stall') +
        '</button>' +
        remove +
        writeForm(hookId) +
        '</li>'
      );
    }

    function peopleFrom(payload) {
      if (payload && payload.group && payload.group.people) return payload.group.people;
      var cards = cardsFrom(payload);
      var byKey = {};
      cards.forEach(function (card, index) {
        var key = String(card.name || '').trim().toLowerCase();
        if (!key) return;
        if (!byKey[key]) {
          byKey[key] = {
            key: key,
            name: card.name,
            stalls: [],
            offers: [],
            neighborKeys: [],
            x: 22 + (index * 17) % 60,
            y: 28 + (index * 11) % 48,
            cluster: 0,
          };
        }
        if (card.kind === 'offer') {
          byKey[key].offers.push({
            id: card.id,
            hookId: card.hookId,
            forName: card.forName,
            place: card.place,
            note: card.note,
            at: card.at,
          });
        } else {
          byKey[key].stalls.push({
            id: card.id,
            place: card.place,
            note: card.note,
            at: card.at,
            offerCount: card.offerCount,
          });
        }
      });
      return Object.keys(byKey).map(function (key) {
        return byKey[key];
      });
    }

    function writeTarget(person) {
      if (person.stalls && person.stalls[0]) return person.stalls[0].id;
      if (person.offers && person.offers[0]) return person.offers[0].hookId;
      return '';
    }

    function floatOpen(person) {
      if (!openBox || !person) return;
      openBox.style.left = person.x + '%';
      openBox.style.top = person.y + '%';
      openBox.style.setProperty('--nudge-x', '0px');
      openBox.style.setProperty('--nudge-y', '0px');
      openBox.classList.toggle('is-left', Number(person.x) >= 55);
      openBox.classList.toggle('is-below', Number(person.y) < 36);
      requestAnimationFrame(function () {
        if (!roomBox || openBox.hidden) return;
        var room = roomBox.getBoundingClientRect();
        var card = openBox.getBoundingClientRect();
        var pad = 12;
        var dx = 0;
        var dy = 0;
        if (card.right > room.right - pad) dx -= card.right - (room.right - pad);
        if (card.left < room.left + pad) dx += room.left + pad - card.left;
        if (card.bottom > room.bottom - pad) dy -= card.bottom - (room.bottom - pad);
        if (card.top < room.top + pad) dy += room.top + pad - card.top;
        openBox.style.setProperty('--nudge-x', dx + 'px');
        openBox.style.setProperty('--nudge-y', dy + 'px');
      });
    }

    function renderOpen(person) {
      if (!openBox) return;
      if (!person) {
        openBox.hidden = true;
        openBox.innerHTML = '';
        openBox.removeAttribute('style');
        openBox.classList.remove('is-left', 'is-below');
        return;
      }
      var hookId = writeTarget(person);
      var remove =
        canModerate && person.stalls && person.stalls[0]
          ? '<button type="button" class="hook-remove" data-remove="' +
            esc(person.stalls[0].id) +
            '">Take down</button>'
          : '';
      var stalls = (person.stalls || [])
        .map(function (stall) {
          return (
            '<article class="open-bit' +
            (isFresh(stall.at) ? ' is-fresh' : '') +
            '">' +
            (isFresh(stall.at) ? '<p class="card-fresh">New</p>' : '') +
            '<p class="card-kind">Stall</p>' +
            '<p class="hook-place">' +
            esc(stall.place) +
            '</p>' +
            '<p class="hook-note">' +
            esc(stall.note) +
            '</p>' +
            '</article>'
          );
        })
        .join('');
      var offers = (person.offers || [])
        .map(function (offer) {
          return (
            '<article class="open-bit' +
            (isFresh(offer.at) ? ' is-fresh' : '') +
            '">' +
            (isFresh(offer.at) ? '<p class="card-fresh">New</p>' : '') +
            '<p class="card-kind">Offer</p>' +
            '<p class="card-for">for ' +
            esc(offer.forName) +
            '</p>' +
            '<p class="hook-note">' +
            esc(offer.note) +
            '</p>' +
            '</article>'
          );
        })
        .join('');
      var near = (person.neighborKeys || [])
        .map(function (key) {
          var other = peopleFrom(lastPayload).find(function (row) {
            return row.key === key;
          });
          return other ? '<button type="button" class="near-name" data-open="' + esc(other.key) + '">' + esc(other.name) + '</button>' : '';
        })
        .filter(Boolean)
        .join('');
      var meKey = selfKey();
      var isSelf = meKey && meKey === person.key;
      var threadHtml = renderCallThread(person);
      var hasThread = !!threadHtml;
      // Near on the map, already talking, or a visitor still choosing a name/place.
      var showCall = !isSelf && (hasThread || canCallClient(person) || !meKey);
      var callBlock = showCall
        ? '<div class="call-upon">' +
          '<p class="call-upon-kicker">Call upon</p>' +
          (hasThread
            ? '<p class="call-upon-hint">A thread is open, keep talking in the little window.</p>'
            : '<p class="call-upon-hint">A short note, brother. The chat stays open while you wander.</p>') +
          '<button type="button" class="btn btn-ghost hook-call" data-open-dock="' +
          esc(person.key) +
          '">' +
          (hasThread ? 'Open chat with ' + esc(person.name) : 'Call upon ' + esc(person.name)) +
          '</button>' +
          '</div>'
        : '';
      var tgBlock = person.telegram
        ? '<div class="tg-bridge">' +
          '<div class="tg-bridge-head">' +
          '<div class="tg-pair tg-pair--compact" aria-hidden="true">' +
          '<span class="tg-pair-crest"><img src="' +
          esc(siteLogo) +
          '" alt="" width="40" height="51" decoding="async" /></span>' +
          '<span class="tg-pair-tg">' +
          tgMarkSvg +
          '</span>' +
          '</div>' +
          '<p class="tg-bridge-kicker">Soul Searchers · opens Telegram</p>' +
          '</div>' +
          '<p class="tg-bridge-hint">They opted in. Opens their chat in Telegram, you still tap Send. Username stays off this map.</p>' +
          '<a class="btn btn-primary hook-tg" href="/api/hooks/telegram?person=' +
          encodeURIComponent(person.key) +
          '" target="soul-telegram">Open Telegram, then Send</a>' +
          '</div>'
        : '';
      var waBlock = person.signal || person.whatsapp
        ? '<div class="wa-bridge">' +
          '<div class="wa-bridge-head">' +
          '<div class="wa-pair wa-pair--compact" aria-hidden="true">' +
