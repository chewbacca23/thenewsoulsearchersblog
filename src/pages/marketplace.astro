---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout
  title="Fresh stuff"
  description="Fresh stuff. A crowd of riders. Ride together, or put down a tire, a saddle, a frame."
>
  <section class="section">
    <div class="site-shell hooks">
      <p class="eyebrow">The floor</p>
      <h1 class="section-title">Fresh stuff</h1>
      <p class="section-lead">
        Room for a thousand. Berlin is the centre of this little universe.<br />
        When someone from Nice or a train joins, they land on the map around it. Each dot is a
        person. Click one and it opens. Call upon someone near you with a short note.<br />
        Email and Telegram stay private. Telegram opens a free door when they opted in. Or Telegram
        a buddy from your contacts: we open the app, you tap Send. Signal is another quiet door when
        you want it.
      </p>

      <section class="wares" aria-label="What you can put down">
        <p class="wares-kicker">On the table</p>
        <ul class="wares-row">
          <li>
            <button
              type="button"
              class="ware"
              data-offer="Sunday ride. Meet when the light is good."
            >
              <span class="ware-mark ride" aria-hidden="true"></span>
              <span class="ware-name">A ride</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="28mm tires. Take them if they fit.">
              <span class="ware-mark tire" aria-hidden="true"></span>
              <span class="ware-name">A tire</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A stem, ready for a new cockpit.">
              <span class="ware-mark stem" aria-hidden="true"></span>
              <span class="ware-name">A stem</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A saddle, sat in, still good.">
              <span class="ware-mark saddle" aria-hidden="true"></span>
              <span class="ware-name">A saddle</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A frame from time to time. Ask before you come.">
              <span class="ware-mark frame" aria-hidden="true"></span>
              <span class="ware-name">A frame</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A bike bag. Frame, saddle, or bar. Ask before you come.">
              <span class="ware-mark bag" aria-hidden="true"></span>
              <span class="ware-name">A bag</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A wheelset. Ask the size before you come.">
              <span class="ware-mark wheels" aria-hidden="true"></span>
              <span class="ware-name">A wheelset</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="A groupset, if it still shifts. Ask before you come.">
              <span class="ware-mark groupset" aria-hidden="true"></span>
              <span class="ware-name">A groupset</span>
            </button>
          </li>
          <li>
            <button type="button" class="ware" data-offer="Small parts. Screws, a top cap, a chain. Ask before you come.">
              <span class="ware-mark parts" aria-hidden="true"></span>
              <span class="ware-name">Small parts</span>
            </button>
          </li>
        </ul>
      </section>

      <p id="welcome-back" class="welcome-back" hidden>
        <span id="welcome-back-text"></span>
        <button type="button" class="welcome-back-open" id="welcome-back-open" hidden>Open them</button>
      </p>

      <p id="calls-for-you" class="calls-for-you" hidden>
        <span id="calls-for-you-text"></span>
        <button type="button" class="calls-for-you-open" id="calls-for-you-open" hidden>Open them</button>
      </p>

      <!-- Top calling toast, calm popup when a brother Call-upons you (on-site only). -->
      <div id="call-toast" class="call-toast" hidden role="status" aria-live="polite">
        <div class="call-toast-card">
          <p class="call-toast-kicker">Call upon</p>
          <p class="call-toast-title" id="call-toast-title">Someone is calling you</p>
          <p class="call-toast-note" id="call-toast-note" hidden></p>
          <div class="call-toast-actions">
            <button type="button" class="btn btn-primary call-toast-open" id="call-toast-open">
              Open the chat
            </button>
            <button type="button" class="call-toast-dismiss" id="call-toast-dismiss" aria-label="Dismiss call">
              Not now
            </button>
          </div>
        </div>
      </div>

      <!-- Client-only Telegram window, paste a name + @handle, open t.me; they still tap Send. -->
      <div id="tg-compose" class="tg-compose" hidden>
        <button type="button" class="tg-compose-backdrop" id="tg-compose-backdrop" aria-label="Close Telegram"></button>
        <div
          class="tg-compose-card"
          role="dialog"
          aria-modal="true"
          aria-labelledby="tg-compose-title"
        >
          <header class="tg-compose-head">
            <div class="tg-pair" aria-hidden="true">
              <span class="tg-pair-crest">
                <img src={site.logo} alt="" width="40" height="51" decoding="async" />
              </span>
              <span class="tg-pair-tg" title="Telegram">
                <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                  <path
                    fill="currentColor"
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.695.064-1.226-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  ></path>
                </svg>
              </span>
            </div>
            <div class="tg-compose-head-copy">
              <p class="tg-compose-kicker">Soul Searchers · opens Telegram</p>
              <h2 class="tg-compose-title" id="tg-compose-title">Message a buddy</h2>
            </div>
            <button type="button" class="tg-compose-close" id="tg-compose-close" aria-label="Close">
              ×
            </button>
          </header>
          <p class="tg-compose-lead">
            Paste a name and their Telegram username. We open Telegram, you tap Send. This stays on
            your device.
          </p>
          <form class="tg-compose-form" id="tg-compose-form">
            <label class="tg-compose-field">
              <span>Name</span>
              <input
                type="text"
                name="name"
                maxlength="80"
                autocomplete="name"
                placeholder="Alex, Hanna, the climbing buddy…"
              />
            </label>
            <label class="tg-compose-field">
              <span>Telegram username</span>
              <input
                type="text"
                name="telegram"
                required
                maxlength="33"
                autocomplete="username"
                placeholder="@handle"
                spellcheck="false"
              />
            </label>
            <p class="tg-compose-hint">
              The <code>@</code> is optional. Opens Telegram on your phone or in the browser; the
              chat waits until you hit Send.
            </p>
            <p class="tg-compose-error" id="tg-compose-error" hidden></p>
            <button class="btn btn-primary tg-compose-send" type="submit">
              Open Telegram, then Send
            </button>
          </form>
        </div>
      </div>

      <!-- Client-only Signal window, paste a name + number, open signal.me; they still tap Send. -->
      <div id="wa-compose" class="wa-compose" hidden>
        <button type="button" class="wa-compose-backdrop" id="wa-compose-backdrop" aria-label="Close Signal"></button>
        <div
          class="wa-compose-card"
          role="dialog"
          aria-modal="true"
          aria-labelledby="wa-compose-title"
        >
          <header class="wa-compose-head">
            <div class="wa-pair" aria-hidden="true">
              <span class="wa-pair-crest">
                <img src={site.logo} alt="" width="40" height="51" decoding="async" />
              </span>
              <span class="wa-pair-wa" title="Signal">
                <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.23 8.24-1.4 0-2.79-.37-4.01-1.06l-.29-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 0 1-1.25-4.48c0-4.54 3.7-8.24 8.23-8.24zm4.52 10.52c-.2-.1-1.18-.58-1.36-.65-.18-.06-.32-.1-.45.1-.13.2-.5.65-.62.78-.11.13-.23.15-.43.05-.2-.1-.84-.31-1.6-.99-.59-.53-.99-1.18-1.1-1.38-.12-.2-.01-.3.09-.4.09-.09.2-.23.3-.35.1-.12.13-.2.2-.33.07-.13.03-.25-.02-.35-.05-.1-.45-1.08-.62-1.47-.16-.39-.33-.33-.45-.34h-.38c-.13 0-.34.05-.52.25-.18.2-.68.67-.68 1.62 0 .96.7 1.87.8 2 .1.13 1.37 2.1 3.32 2.94.46.2.83.32 1.11.41.47.15.89.13 1.23.08.37-.06 1.18-.48 1.34-.95.17-.47.17-.87.12-.95-.05-.08-.18-.13-.38-.23z"
                  ></path>
                </svg>
              </span>
            </div>
            <div class="wa-compose-head-copy">
              <p class="wa-compose-kicker">Soul Searchers · opens Signal</p>
              <h2 class="wa-compose-title" id="wa-compose-title">Message a buddy</h2>
            </div>
            <button type="button" class="wa-compose-close" id="wa-compose-close" aria-label="Close">
              ×
            </button>
          </header>
          <p class="wa-compose-lead">
            Paste a name and number from your phone. We open Signal, you tap Send. This stays on
            your device.
          </p>
          <form class="wa-compose-form" id="wa-compose-form">
            <label class="wa-compose-field">
              <span>Name</span>
              <input
                type="text"
                name="name"
                maxlength="80"
                autocomplete="name"
                placeholder="Alex, Hanna, the climbing buddy…"
              />
            </label>
            <label class="wa-compose-field">
              <span>Number · include country code</span>
              <input
                type="tel"
                name="phone"
                required
                maxlength="32"
                inputmode="tel"
                autocomplete="tel"
                placeholder="+49 170 …"
              />
            </label>
            <p class="wa-compose-hint">
              Keep the country code, <code>+49…</code> for Germany. Opens Signal on your phone or
              in the browser; you still tap Send.
            </p>
            <p class="wa-compose-error" id="wa-compose-error" hidden></p>
            <button class="btn btn-primary wa-compose-send" type="submit">
              Open Signal, then Send
            </button>
          </form>
        </div>
      </div>

      <p id="board-error" class="error" hidden></p>
      <p id="board-hint" class="hint" hidden></p>

      <section class="group" id="group" aria-label="The group">
        <p class="group-kicker">The crowd · Berlin at the centre <span id="group-count"></span></p>
        <div class="group-room" id="group-room">
          <!-- Soft Berlin outline, dots sit roughly where people said they ride. -->
          <svg
            class="berlin-outline"
            viewBox="0 0 121.42 100.0"
            preserveAspectRatio="xMidYMid meet"
            aria-hidden="true"
          >
            <!-- Real Berlin city boundary (OSM/Nominatim), simplified for the crowd room. -->
            <path class="berlin-fill" d="M3.64 74.32 L4.05 76.57 L5.18 77.16 L5.77 75.95 L6.67 77.12 L7.25 76.18 L6.70 77.37 L9.82 80.66 L12.08 80.39 L10.25 82.13 L10.89 83.34 L12.71 80.60 L17.79 81.00 L15.42 80.80 L15.69 78.99 L22.12 75.46 L30.38 73.89 L31.03 78.40 L35.17 78.45 L39.00 75.26 L41.59 80.04 L46.90 76.52 L46.85 77.65 L51.75 81.52 L51.48 83.01 L54.36 82.97 L54.55 85.96 L60.04 86.44 L61.17 83.64 L59.69 77.01 L67.29 73.91 L70.04 80.92 L76.19 79.29 L78.51 80.54 L79.99 79.61 L79.50 82.86 L84.36 83.09 L89.20 81.51 L91.43 87.14 L95.28 84.98 L96.07 86.41 L97.68 86.06 L98.44 88.98 L97.07 90.66 L96.60 94.61 L99.04 96.83 L102.52 89.13 L104.37 88.25 L106.08 88.93 L107.40 86.59 L107.20 84.94 L105.17 83.88 L110.09 79.87 L112.68 79.79 L114.02 77.74 L112.46 75.23 L114.40 72.33 L114.20 70.74 L111.27 69.44 L114.68 70.61 L115.97 68.23 L116.95 68.19 L116.64 69.56 L117.78 69.28 L116.79 69.08 L116.98 66.92 L112.34 65.63 L110.11 62.25 L107.62 60.77 L108.18 64.53 L107.12 64.39 L106.63 61.90 L98.63 57.84 L94.74 59.25 L94.30 61.27 L94.03 60.15 L92.37 60.10 L92.96 57.28 L95.48 53.86 L94.51 53.53 L95.95 48.88 L100.36 44.69 L100.09 43.60 L94.80 43.50 L94.65 41.30 L96.20 41.42 L96.78 40.14 L88.13 38.04 L87.31 32.10 L85.11 31.54 L81.47 27.43 L74.85 26.24 L72.99 22.19 L74.47 16.87 L76.50 15.80 L77.38 11.49 L71.91 8.77 L70.99 7.48 L71.51 4.32 L69.16 5.07 L69.99 3.00 L65.13 6.58 L68.98 8.29 L68.38 9.59 L66.64 10.64 L63.44 10.31 L62.32 13.47 L60.64 14.16 L58.60 11.93 L55.59 10.79 L52.50 16.14 L49.33 17.64 L39.99 16.47 L41.29 15.68 L41.14 12.14 L39.62 9.13 L41.26 8.05 L36.62 7.12 L36.80 12.58 L33.13 12.71 L33.48 16.56 L26.07 16.15 L22.86 22.22 L25.78 26.17 L25.53 27.54 L23.50 27.71 L16.57 24.38 L10.53 27.58 L11.13 29.73 L14.04 28.68 L14.70 31.50 L13.35 37.22 L10.79 36.32 L8.57 47.16 L12.94 46.43 L17.29 49.34 L10.43 57.54 L8.62 58.24 L7.20 65.68 L9.55 69.00 L4.91 73.66 Z" />
            <path class="berlin-stroke" d="M3.64 74.32 L4.05 76.57 L5.18 77.16 L5.77 75.95 L6.67 77.12 L7.25 76.18 L6.70 77.37 L9.82 80.66 L12.08 80.39 L10.25 82.13 L10.89 83.34 L12.71 80.60 L17.79 81.00 L15.42 80.80 L15.69 78.99 L22.12 75.46 L30.38 73.89 L31.03 78.40 L35.17 78.45 L39.00 75.26 L41.59 80.04 L46.90 76.52 L46.85 77.65 L51.75 81.52 L51.48 83.01 L54.36 82.97 L54.55 85.96 L60.04 86.44 L61.17 83.64 L59.69 77.01 L67.29 73.91 L70.04 80.92 L76.19 79.29 L78.51 80.54 L79.99 79.61 L79.50 82.86 L84.36 83.09 L89.20 81.51 L91.43 87.14 L95.28 84.98 L96.07 86.41 L97.68 86.06 L98.44 88.98 L97.07 90.66 L96.60 94.61 L99.04 96.83 L102.52 89.13 L104.37 88.25 L106.08 88.93 L107.40 86.59 L107.20 84.94 L105.17 83.88 L110.09 79.87 L112.68 79.79 L114.02 77.74 L112.46 75.23 L114.40 72.33 L114.20 70.74 L111.27 69.44 L114.68 70.61 L115.97 68.23 L116.95 68.19 L116.64 69.56 L117.78 69.28 L116.79 69.08 L116.98 66.92 L112.34 65.63 L110.11 62.25 L107.62 60.77 L108.18 64.53 L107.12 64.39 L106.63 61.90 L98.63 57.84 L94.74 59.25 L94.30 61.27 L94.03 60.15 L92.37 60.10 L92.96 57.28 L95.48 53.86 L94.51 53.53 L95.95 48.88 L100.36 44.69 L100.09 43.60 L94.80 43.50 L94.65 41.30 L96.20 41.42 L96.78 40.14 L88.13 38.04 L87.31 32.10 L85.11 31.54 L81.47 27.43 L74.85 26.24 L72.99 22.19 L74.47 16.87 L76.50 15.80 L77.38 11.49 L71.91 8.77 L70.99 7.48 L71.51 4.32 L69.16 5.07 L69.99 3.00 L65.13 6.58 L68.98 8.29 L68.38 9.59 L66.64 10.64 L63.44 10.31 L62.32 13.47 L60.64 14.16 L58.60 11.93 L55.59 10.79 L52.50 16.14 L49.33 17.64 L39.99 16.47 L41.29 15.68 L41.14 12.14 L39.62 9.13 L41.26 8.05 L36.62 7.12 L36.80 12.58 L33.13 12.71 L33.48 16.56 L26.07 16.15 L22.86 22.22 L25.78 26.17 L25.53 27.54 L23.50 27.71 L16.57 24.38 L10.53 27.58 L11.13 29.73 L14.04 28.68 L14.70 31.50 L13.35 37.22 L10.79 36.32 L8.57 47.16 L12.94 46.43 L17.29 49.34 L10.43 57.54 L8.62 58.24 L7.20 65.68 L9.55 69.00 L4.91 73.66 Z" />
          </svg>
          <!-- Links + dots share one floor so SVG % and CSS % use the same box. -->
          <div class="group-floor" id="group-floor">
            <svg class="group-links" id="group-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
            <div class="group-dots" id="group-dots">
              <p class="group-empty">No one standing here yet.</p>
            </div>
          </div>
          <aside class="group-open" id="group-open" hidden></aside>
        </div>
      </section>

      <aside class="crowd-sign" id="crowd-sign" aria-live="polite">
        <p class="crowd-sign-kicker">Already here</p>
        <p class="crowd-sign-count">
          <span id="crowd-sign-num">0</span>
          <span class="crowd-sign-unit" id="crowd-sign-unit">riders standing</span>
        </p>
        <p class="crowd-sign-line" id="crowd-sign-line">
          Be the first. Open a stall, show up for a ride, make coming back a habit.
        </p>
        <a class="btn btn-primary crowd-sign-cta" href="#pin-form">Stand with them</a>
        <button type="button" class="btn btn-primary crowd-sign-tg" id="tg-compose-open">
          Telegram a buddy
        </button>
        <button type="button" class="crowd-sign-wa-quiet" id="wa-compose-open">
          Signal a buddy
        </button>
      </aside>

      <aside id="cookie-note" class="cookie-note" hidden>
        <p class="cookie-note-text">
          Yes, cookies. A light one called <code>soul_on_map</code>, plus a little local memory on
          your machine, so when you stand on the map we can welcome you back to the person you last
          talked to, and quietly show if someone called upon you. Optional email, Telegram username,
          and Signal phone stay private, off the public map. Messengers open for people who opted
          in; the visitor still taps Send. Private visits. Just the good kind of remembering.
          <span class="cookie-wink" aria-hidden="true">;)</span>
        </p>
        <button type="button" class="cookie-note-ok" id="cookie-note-ok">Got it, brother</button>
      </aside>

      <p class="floor-kicker">The floor</p>
      <ol id="hook-list" class="market">
        <li class="empty">The floor is empty. Open the first stall.</li>
      </ol>

      <div id="pin-success" class="success" hidden>
        <h2>It’s on the floor</h2>
        <p>
          If you left a mail, offers can also land in your inbox. If you left a Telegram username or
          a phone, brothers can open that messenger to you. The handle and digits stay off the map,
          and they still tap Send. Either way, the stall shows here.
        </p>
      </div>

      <!-- One calm Call upon dock, stays open while you wander the map. -->
      <aside id="chat-dock" class="chat-dock" hidden aria-live="polite">
        <div class="chat-dock-card">
          <header class="chat-dock-head">
            <p class="chat-dock-kicker">Call upon</p>
            <h2 class="chat-dock-name" id="chat-dock-name">Brother</h2>
            <span class="chat-dock-ping" id="chat-dock-ping" hidden aria-hidden="true"></span>
            <button
              type="button"
              class="chat-dock-mute"
              id="chat-dock-mute"
              aria-pressed="false"
              aria-label="Mute reply sound"
              title="Mute reply sound"
            >
              <svg class="chat-dock-mute-on" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M4 10v4h3l4 3V7L7 10H4zm11.5 2a3.5 3.5 0 0 0-1.8-3.05v6.1A3.5 3.5 0 0 0 15.5 12zm-1.8-7.45v1.7a6 6 0 0 1 0 11.5v1.7a7.7 7.7 0 0 0 0-14.9z"
                />
              </svg>
              <svg class="chat-dock-mute-off" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" hidden>
                <path
                  fill="currentColor"
                  d="M4 10v4h3l4 3V7L7 10H4zm11.5 2a3.5 3.5 0 0 0-1.8-3.05v3.2l1.8-.15zm2.7-6.2-.95.95A6 6 0 0 1 18.7 12a6 6 0 0 1-1.4 3.9l.95.95A7.7 7.7 0 0 0 20.5 12a7.7 7.7 0 0 0-2.3-5.45zM4.27 3 3 4.27 7.73 9H4v4h3l4 3v-4.73l5.27 5.27.73-.73L4.27 3zM13 7l-1.18 1.18L13 8.36V7z"
                />
              </svg>
            </button>
            <button type="button" class="chat-dock-close" id="chat-dock-close" aria-label="End this chat">
              ×
            </button>
          </header>
          <ol class="chat-dock-thread" id="chat-dock-thread" aria-label="Call upon thread"></ol>
          <p class="chat-dock-empty" id="chat-dock-empty" hidden>
            A short note. Coffee before the climb, a spare tire, a place to meet.
          </p>
          <form class="chat-dock-form" id="chat-dock-form">
            <label class="chat-dock-field chat-dock-field-name">
              <span>A name, any name</span>
              <input type="text" name="name" required maxlength="80" autocomplete="nickname" />
            </label>
            <label class="chat-dock-field chat-dock-field-place">
              <span>Your place, so we know you are near</span>
              <input type="text" name="place" maxlength="80" placeholder="Berlin outskirts, Kreuzberg, Nice…" />
            </label>
            <label class="chat-dock-field chat-dock-field-msg">
              <span id="chat-dock-msg-label">Call upon them</span>
              <textarea
                name="message"
                rows="2"
                required
                maxlength="500"
                placeholder="Brother, coffee before the climb?"
              ></textarea>
            </label>
            <label class="chat-dock-field chat-dock-field-email">
              <span>Email, optional, stays off the page</span>
              <input type="email" name="email" maxlength="200" autocomplete="email" />
            </label>
            <label class="hp" aria-hidden="true">
              <span>Fax</span>
              <input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary chat-dock-send" type="submit" id="chat-dock-send">
              Send call upon
            </button>
          </form>
        </div>
      </aside>

      <form id="pin-form" class="form" method="post" action="/api/hooks">
        <h2 class="form-title">Open a stall</h2>
        <label>
          <span>A name, any name</span>
          <input type="text" name="name" required maxlength="80" placeholder="The dog, Alex, nobody" />
        </label>
        <label>
          <span>Where</span>
          <input
            type="text"
            name="place"
            required
            maxlength="80"
            placeholder="Berlin outskirts, Kreuzberg, Nice…"
          />
        </label>
        <label>
          <span>The offer</span>
          <textarea
            name="note"
            rows="3"
            required
            maxlength="400"
            placeholder="Sunday ride from Kreuzberg. 28mm tires, take them. A stem, a saddle, a frame from time to time."
          ></textarea>
        </label>
        <label>
          <span>Email, optional, stays off the page</span>
          <input type="email" name="email" autocomplete="email" maxlength="200" />
        </label>
        <label>
          <span>Telegram, optional, kept off the map</span>
          <input
            type="text"
            name="telegram"
            autocomplete="username"
            maxlength="33"
            placeholder="@handle"
            spellcheck="false"
          />
        </label>
        <p class="phone-bridge-hint">
          Opt in if you want an Open Telegram button on your dot. The username stays private. We
          open Telegram for visitors; they still hit Send. The <code>@</code> is optional.
        </p>
        <label>
          <span>Signal, optional, quieter, kept off the map</span>
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            maxlength="32"
            inputmode="tel"
            placeholder="+49 170 …"
          />
        </label>
        <p class="phone-bridge-hint phone-bridge-hint--quiet">
          Opt in if you want an Open Signal button on your dot. Digits stay private. Best as
          <code>+49…</code> with country code.
        </p>
        <label class="hp" aria-hidden="true">
          <span>Company</span>
          <input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn-primary" type="submit">Put it on the floor</button>
        <p class="cookie-pin-hint">
          Putting yourself on the floor leaves that light cookie and local memory, so coming back
          still finds you. More in the note up top, and on the
          <a href="/impressum">imprint</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

