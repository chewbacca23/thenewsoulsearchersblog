    /** Visual mark centre in the shared floor’s 0-100 space (matches SVG viewBox). */
    function markCenterPct(dotEl, floorRect) {
      if (!dotEl || !floorRect || floorRect.width < 1 || floorRect.height < 1) return null;
      var mark = dotEl.querySelector('.dot-mark') || dotEl;
      var box = mark.getBoundingClientRect();
      return {
        x: (((box.left + box.right) / 2 - floorRect.left) / floorRect.width) * 100,
        y: (((box.top + box.bottom) / 2 - floorRect.top) / floorRect.height) * 100,
        rPx: Math.min(box.width, box.height) / 2,
      };
    }

    /**
     * Centre of bubble A → centre of bubble B in the shared floor’s 0-100 space.
     * Measures live .dot-mark boxes so host / crowd / pack / open-scale stay aligned.
     */
    function linkChord(a, b, floorRect) {
      var ca = markCenterPct(a, floorRect);
      var cb = markCenterPct(b, floorRect);
      if (!ca || !cb) return null;
      return { x1: ca.x, y1: ca.y, x2: cb.x, y2: cb.y };
    }

    function paintGroupLinks(people, byKey, selected, near) {
      if (!linksBox) return;
      var floorRect = (floorBox || roomBox || linksBox).getBoundingClientRect();
      var lines = [];
      var seen = {};
      var drawAll = people.length < 80;
      people.forEach(function (person) {
        if (!drawAll && (!selected || (person.key !== selected.key && !near[person.key]))) return;
        (person.neighborKeys || []).forEach(function (key) {
          var edge = person.key < key ? person.key + '|' + key : key + '|' + person.key;
          if (seen[edge]) return;
          seen[edge] = true;
          var other = byKey[key];
          if (!other) return;
          var hot = selected && (person.key === selected.key || other.key === selected.key);
          if (!drawAll && !hot) return;
          var aEl = dotsBox.querySelector('.dot[data-open="' + CSS.escape(person.key) + '"]');
          var bEl = dotsBox.querySelector('.dot[data-open="' + CSS.escape(other.key) + '"]');
          var chord = linkChord(aEl, bEl, floorRect);
          if (!chord) {
            chord = {
              x1: Number(person.x) || 0,
              y1: Number(person.y) || 0,
              x2: Number(other.x) || 0,
              y2: Number(other.y) || 0,
            };
          }
          lines.push(
            '<line x1="' +
              chord.x1 +
              '" y1="' +
              chord.y1 +
              '" x2="' +
              chord.x2 +
              '" y2="' +
              chord.y2 +
              '" class="' +
              (hot ? 'is-hot' : '') +
              '" />',
          );
        });
      });
      linksBox.innerHTML = lines.join('');
    }

    function renderGroup(payload) {
      if (!dotsBox) return;
      var people = peopleFrom(payload);
      writeCrowdSign(people.length);
      var outline = document.querySelector('.berlin-outline');
      var universe = (payload && payload.group && payload.group.universe) || {};
      var zoom = Number(universe.zoom);
      if (!zoom || zoom <= 0) zoom = 1;
      if (outline) {
        var cx = (universe.center && universe.center.x) || 50;
        var cy = (universe.center && universe.center.y) || 48;
        outline.style.transformOrigin = cx + '% ' + cy + '%';
        outline.style.transform = 'scale(' + zoom + ')';
        outline.classList.toggle('is-zoomed', zoom < 0.97);
      }
      if (countBox) {
        countBox.textContent = people.length
          ? people.length === 1
            ? '· 1 standing'
            : '· ' + people.length + ' standing'
          : '';
      }
      if (!people.length) {
        dotsBox.className = 'group-dots';
        dotsBox.innerHTML = '<p class="group-empty">No one standing here yet.</p>';
        if (linksBox) linksBox.innerHTML = '';
        renderOpen(null);
        return;
      }
      dotsBox.className =
        'group-dots' + (people.length > 200 ? ' is-pack' : people.length > 40 ? ' is-crowd' : '');
      var byKey = {};
      people.forEach(function (person) {
        byKey[person.key] = person;
      });
      var selected = byKey[openKey] || null;
      if (openKey && !selected) openKey = '';
      var near = {};
      if (selected) {
        (selected.neighborKeys || []).forEach(function (key) {
          near[key] = true;
        });
      }
      // Paint dots first so link endpoints can measure real mark centres.
      dotsBox.innerHTML = people
        .map(function (person) {
          var host = person.stalls && person.stalls.length;
          var fresh = personIsFresh(person);
          var state = person.key === openKey ? ' is-open' : near[person.key] ? ' is-near' : '';
          return (
            '<button type="button" class="dot' +
            (host ? ' is-host' : '') +
            (fresh ? ' is-fresh' : '') +
            state +
            '" style="left:' +
            person.x +
            '%;top:' +
            person.y +
            '%" data-open="' +
            esc(person.key) +
            '" aria-pressed="' +
            (person.key === openKey ? 'true' : 'false') +
            '" aria-label="' +
            esc(person.name) +
            (fresh ? ', new on the floor' : '') +
            '">' +
            '<span class="dot-mark"></span>' +
            '<span class="dot-name">' +
            esc(person.name) +
            '</span>' +
            '</button>'
          );
        })
        .join('');
      paintGroupLinks(people, byKey, selected, near);
      renderOpen(selected || null);
    }

    function render(payload) {
      if (payload && payload.ok && !payload.hooks && !payload.market && !payload.group) {
        load();
        return;
      }
      lastPayload = payload || lastPayload;
      renderGroup(lastPayload);
      if (dockKey) renderChatDock();
      if (!list) return;
      var cards = cardsFrom(lastPayload);
      if (!cards.length) {
        list.innerHTML = '<li class="empty">The floor is empty. Open the first stall.</li>';
        return;
