      tgCompose.classList.remove('is-open');
      if (tgComposeCloseTimer) window.clearTimeout(tgComposeCloseTimer);
      tgComposeCloseTimer = window.setTimeout(function () {
        tgComposeCloseTimer = 0;
        tgCompose.classList.remove('is-closing');
        tgCompose.hidden = true;
      }, 220);
    }

    function closeWaCompose() {
      if (!waCompose || waCompose.hidden) return;
      showWaComposeError('');
      document.documentElement.classList.remove('wa-compose-open');
      if (prefersReducedMotion()) {
        waCompose.classList.remove('is-open', 'is-closing');
        waCompose.hidden = true;
        return;
      }
      waCompose.classList.add('is-closing');
      waCompose.classList.remove('is-open');
      if (waComposeCloseTimer) window.clearTimeout(waComposeCloseTimer);
      waComposeCloseTimer = window.setTimeout(function () {
        waComposeCloseTimer = 0;
        waCompose.classList.remove('is-closing');
        waCompose.hidden = true;
      }, 220);
    }

    if (tgComposeOpen) {
      tgComposeOpen.addEventListener('click', function () {
        openTgCompose();
      });
    }
    if (tgComposeClose) {
      tgComposeClose.addEventListener('click', function () {
        closeTgCompose();
      });
    }
    if (tgComposeBackdrop) {
      tgComposeBackdrop.addEventListener('click', function () {
        closeTgCompose();
      });
    }
    if (tgComposeForm) {
      tgComposeForm.addEventListener('submit', function (event) {
        event.preventDefault();
        var data = new FormData(tgComposeForm);
        var handle = String(data.get('telegram') || '').trim();
        var url = telegramMeUrl(handle);
        if (!url) {
          showTgComposeError(
            'Add a Telegram username, like @handle, then Open Telegram and tap Send.',
          );
          var tgEl = tgComposeForm.elements.namedItem('telegram');
          if (tgEl) tgEl.focus();
          return;
        }
        showTgComposeError('');
        openSoulTelegram(url);
      });
    }

    if (waComposeOpen) {
      waComposeOpen.addEventListener('click', function () {
        openWaCompose();
      });
    }
    if (waComposeClose) {
      waComposeClose.addEventListener('click', function () {
        closeWaCompose();
      });
    }
    if (waComposeBackdrop) {
      waComposeBackdrop.addEventListener('click', function () {
        closeWaCompose();
      });
    }
    if (waComposeForm) {
      waComposeForm.addEventListener('submit', function (event) {
        event.preventDefault();
        var data = new FormData(waComposeForm);
        var name = String(data.get('name') || '').trim();
        var phone = String(data.get('phone') || '').trim();
        var url = waMeUrl(phone, name);
        if (!url) {
          showWaComposeError(
            'Add a number with country code, like +49…, then Open Signal and tap Send.',
          );
          var phoneEl = waComposeForm.elements.namedItem('phone');
          if (phoneEl) phoneEl.focus();
          return;
        }
        showWaComposeError('');
        openSoulWhatsApp(url);
      });
    }

