---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import saved from '../content/settings/site.json';
import { publicImprint } from '../lib/site-settings';

const imprint = publicImprint(saved);
---

<BaseLayout
  title="Imprint / Impressum"
  description={`Legal notice (Impressum) for ${site.name}.`}
>
  <section class="section">
    <div class="site-shell legal">
      <p class="eyebrow">Legal</p>
      <h1 class="section-title">Imprint / Impressum</h1>
      <p class="section-lead">Angaben gemäß § 5 TMG.</p>

      <h2>Angaben zum Anbieter</h2>
      <p data-site="provider">
        {imprint.legalName}<br />
        {imprint.responsible}
        {imprint.street && <><br />{imprint.street}</>}
        {imprint.zipCity && <><br />{imprint.zipCity}</>}
        {imprint.country && <><br />{imprint.country}</>}
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a data-site="email" href={`mailto:${imprint.email}`}>{imprint.email}</a>
        <span data-site="phone">
          {imprint.phone && (
            <>
              <br />
              Telefon: {imprint.phone}
            </>
          )}
        </span>
      </p>

      <h2>Verantwortlich für den Inhalt</h2>
      <p data-site="responsible">
        {imprint.responsible}
        {imprint.street && <><br />{imprint.street}</>}
        {imprint.zipCity && <><br />{imprint.zipCity}</>}
      </p>

      <h2>Haftung für Inhalte</h2>
      <p>
        Die Inhalte dieser Seiten wurden mit größter Sorgfalt erstellt. Für die Richtigkeit,
        Vollständigkeit und Aktualität der Inhalte können wir jedoch keine Gewähr übernehmen.
      </p>

      <h2>Haftung für Links</h2>
      <p>
        Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir keinen
        Einfluss haben. Deshalb können wir für diese fremden Inhalte auch keine Gewähr übernehmen.
      </p>

      <h2>Visits</h2>
      <p>
        We count how many times a public page is opened, the country and approximate city
        Cloudflare sees from the connection, and the site that sent someone here. Names stay
        out. The counts stay on a private page for the site owner.
      </p>

      <h2>The Table</h2>
      <p>
        On The Table we use a light cookie (<code>soul_on_map</code>) and a little
        local memory in your browser so, if you put yourself on the map, coming back can still
        find you, the person you last talked to, and any short “call upon” notes waiting for you.
        Emails stay off the public page. Optional Telegram username and Signal phone are the
        same: stored only to open that messenger for people who opted in, and kept off the map.
        Opening the bridge leaves the Send tap to you in Telegram or Signal.
        Private visits. Just remembering where you stood, brother to brother.
      </p>

      <h2>Urheberrecht</h2>
      <p>
        Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem
        deutschen Urheberrecht.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 40rem;
  }

  h2 {
    margin: 2rem 0 0.65rem;
    font-size: 1.25rem;
  }

  a {
    color: var(--amber-hot);
  }

  code {
    font-size: 0.92em;
    color: var(--amber-hot);
  }
</style>
