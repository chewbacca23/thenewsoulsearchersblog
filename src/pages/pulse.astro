---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { newestFirst } from '../lib/newest';

const entries = newestFirst(
  await getCollection('pulse', ({ data }) => !data.draft),
  (entry) => entry.data.pubDate,
);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
});
---

<BaseLayout
  title="Thin tires"
  description="Road cycling news and photos from the thin-tire world — updated every few days on The Soul Searchers."
>
  <section class="section">
    <div class="site-shell pulse">
      <p class="eyebrow reveal">Thin tires</p>
      <h1 class="section-title reveal reveal-delay-1">From the peloton</h1>
      <p class="section-lead reveal reveal-delay-2">
        Road news that keeps the site on point.<br />
        Fresh every few days — open a headline, or edit any piece in the editor.
      </p>

      <ol class="pulse-list reveal reveal-delay-3" data-pulse-list>
        {
          entries.length === 0 ? (
            <li class="empty">Thin tires news lands here every few days.</li>
          ) : (
            entries.map((entry) => {
              const { title, source, url, image, note, pubDate } = entry.data;
              const when = dateFmt.format(pubDate);
              const href = url || '#';
              return (
                <li class="pulse-item">
                  {image ? (
                    <a
                      class="pulse-media"
                      href={href}
                      target={url ? '_blank' : undefined}
                      rel={url ? 'noopener noreferrer' : undefined}
                    >
                      <img
                        class="pulse-thumb"
                        src={image}
                        alt=""
                        width="320"
                        height="200"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    </a>
                  ) : null}
                  <div class="pulse-copy">
                    <p class="pulse-meta">{[source, when].filter(Boolean).join(' · ')}</p>
                    <h2 class="pulse-title">
                      {url ? (
                        <a href={url} target="_blank" rel="noopener noreferrer">
                          {title}
                        </a>
                      ) : (
                        title
                      )}
                    </h2>
                    {note ? <p class="pulse-note">{note}</p> : null}
                  </div>
                </li>
              );
            })
          )
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .pulse {
    max-width: 42rem;
  }

  .pulse-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }

  .pulse-item {
    display: grid;
    gap: 0.85rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .pulse-item {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.1rem;
    }
  }

  .pulse-media {
    display: block;
    overflow: hidden;
    border-radius: 0.65rem;
    aspect-ratio: 8 / 5;
    background: #121820;
  }

  .pulse-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pulse-meta {
    margin: 0 0 0.35rem;
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pulse-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .pulse-title a {
    color: inherit;
    text-decoration: none;
  }

  .pulse-title a:hover {
    color: var(--amber-hot);
  }

  .pulse-note {
    margin: 0.45rem 0 0;
    color: rgba(215, 224, 232, 0.72);
    max-width: 36rem;
  }

  .empty {
    color: rgba(215, 224, 232, 0.68);
  }
</style>
