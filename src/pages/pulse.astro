---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { newestFirst } from '../lib/newest';

const SECTION_META = [
  { id: 'road-men', label: 'Road race — men' },
  { id: 'road-women', label: 'Road race — women' },
  { id: 'cyclo-cross', label: 'Cyclo-cross' },
] as const;

const entries = newestFirst(
  await getCollection('pulse', ({ data }) => !data.draft),
  (entry) => entry.data.pubDate,
);

const groups = SECTION_META.map((section) => ({
  ...section,
  items: entries.filter((entry) => (entry.data.section || 'road-men') === section.id),
}));

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
});
---

<BaseLayout
  title="Thin tires"
  description="Road men, road women, and cyclo-cross — thin-tire hype updated every couple of days on The Soul Searchers."
>
  <section class="section">
    <div class="site-shell pulse">
      <p class="eyebrow reveal">Thin tires</p>
      <h1 class="section-title reveal reveal-delay-1">From the peloton</h1>
      <p class="section-lead reveal reveal-delay-2">
        Three lanes of hype: road race men, road race women, cyclo-cross.<br />
        Fresh every couple of days — open a headline, or rewrite any piece in the editor.
      </p>

      <div class="pulse-board reveal reveal-delay-3" data-pulse-board>
        {
          groups.every((group) => group.items.length === 0) ? (
            <p class="empty">Thin tires news lands here every couple of days.</p>
          ) : (
            groups.map((group) => (
              <section class="pulse-block" aria-labelledby={`pulse-${group.id}`}>
                <h2 id={`pulse-${group.id}`} class="pulse-heading">
                  {group.label}
                </h2>
                <ol class="pulse-list">
                  {group.items.length === 0 ? (
                    <li class="empty">Quiet in this lane — check back in a couple of days.</li>
                  ) : (
                    group.items.map((entry) => {
                      const { title, source, url, image, note, pubDate } = entry.data;
                      const when = dateFmt.format(pubDate);
                      const href = url || '#';
                      return (
                        <li class="pulse-item">
                          {image ? (
                            <a
                              class="pulse-media"
                              href={href}
                              target={url ? '_blank' : undefined}
                              rel={url ? 'noopener noreferrer' : undefined}
                            >
                              <img
                                class="pulse-thumb"
                                src={image}
                                alt=""
                                width="320"
                                height="200"
                                loading="lazy"
                                decoding="async"
                                referrerpolicy="no-referrer"
                              />
                            </a>
                          ) : null}
                          <div class="pulse-copy">
                            <p class="pulse-meta">{[source, when].filter(Boolean).join(' · ')}</p>
                            <h3 class="pulse-title">
                              {url ? (
                                <a href={url} target="_blank" rel="noopener noreferrer">
                                  {title}
                                </a>
                              ) : (
                                title
                              )}
                            </h3>
                            {note ? <p class="pulse-note">{note}</p> : null}
                          </div>
                        </li>
                      );
                    })
                  )}
                </ol>
              </section>
            ))
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pulse {
    max-width: 42rem;
  }

  .pulse-board {
    display: grid;
    gap: 2.5rem;
  }

  .pulse-heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--paper);
  }

  .pulse-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }

  .pulse-item {
    display: grid;
    gap: 0.85rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .pulse-item {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.1rem;
    }
  }

  .pulse-media {
    display: block;
    overflow: hidden;
    border-radius: 0.65rem;
    aspect-ratio: 8 / 5;
    background: #121820;
  }

  .pulse-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pulse-meta {
    margin: 0 0 0.35rem;
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pulse-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .pulse-title a {
    color: inherit;
    text-decoration: none;
  }

  .pulse-title a:hover {
    color: var(--amber-hot);
  }

  .pulse-note {
    margin: 0.45rem 0 0;
    color: rgba(215, 224, 232, 0.72);
    max-width: 36rem;
  }

  .empty {
    color: rgba(215, 224, 232, 0.68);
  }
</style>
