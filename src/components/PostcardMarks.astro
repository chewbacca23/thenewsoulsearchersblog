---
interface Props {
  variant: number;
  sheet?: boolean;
  treat?: 'scribble' | 'spray' | 'dunk' | 'rothko';
}

const { variant, sheet = false, treat = 'scribble' } = Astro.props;
const which = variant % 3;
const side = variant % 2;
---

{
  treat === 'rothko' && !sheet ? (
    <span class="rothko" aria-hidden="true">
      <i class="band band-a"></i>
      <i class="band band-b"></i>
      <i class="band band-c"></i>
    </span>
  ) : null
}

<svg
  class:list={['marks', { sheet }]}
  viewBox={sheet ? '0 0 100 100' : '0 0 100 125'}
  preserveAspectRatio={sheet ? 'none' : 'xMidYMid slice'}
  aria-hidden="true"
>
  {
    sheet ? (
      <g>
        <polygon class="block yellow" points="0,0 22,1 18,14 0,16" />
        <path class="ink heavy" d="M84 1 C 92 0, 99 5, 98 12 C 96 18, 86 16, 84 9" />
        <path class="ink" d="M90 22 L 99 18 M 93 27 L 100 22" />
        <path class="crayon" d="M0 38 C 7 34, 5 44, 0 46" />
        <polygon class="block blue" points="0,88 10,86 12,100 0,100" />
        <polygon class="block red" points="90,86 100,84 100,100 88,100" />
        <circle class="dot" cx="96" cy="32" r="1.1" />
        <circle class="dot" cx="98" cy="36" r="0.8" />
      </g>
    ) : treat === 'spray' && side === 0 ? (
      <g>
        <path class="spray-stroke" d="M58 18 C 72 8, 88 22, 96 14" />
        <path class="drip" d="M64 20 L 62 48" />
        <path class="drip" d="M78 16 L 80 62" />
        <path class="drip red-drip" d="M90 18 L 88 40" />
        <circle class="speck" cx="70" cy="14" r="0.7" />
        <circle class="speck" cx="74" cy="11" r="0.45" />
        <circle class="speck" cx="82" cy="9" r="0.6" />
        <circle class="speck" cx="88" cy="12" r="0.35" />
        <circle class="speck" cx="93" cy="8" r="0.5" />
        <circle class="speck" cx="66" cy="22" r="0.4" />
        <circle class="speck" cx="86" cy="26" r="0.55" />
        <circle class="speck" cx="97" cy="22" r="0.3" />
        <circle class="speck red-speck" cx="76" cy="28" r="0.5" />
        <circle class="speck red-speck" cx="84" cy="32" r="0.35" />
        <circle class="speck" cx="60" cy="30" r="0.25" />
        <circle class="speck" cx="99" cy="16" r="0.4" />
      </g>
    ) : treat === 'spray' ? (
      <g>
        <path class="spray-stroke yellow-stroke" d="M6 46 C 28 34, 52 58, 78 42" />
        <path class="drip yellow-drip" d="M18 44 L 16 78" />
        <path class="drip yellow-drip" d="M36 40 L 38 96" />
        <path class="drip blue-drip" d="M58 48 L 56 84" />
        <circle class="speck yellow-speck" cx="12" cy="40" r="0.7" />
        <circle class="speck yellow-speck" cx="22" cy="36" r="0.4" />
        <circle class="speck yellow-speck" cx="30" cy="48" r="0.55" />
        <circle class="speck blue-speck" cx="48" cy="38" r="0.6" />
        <circle class="speck blue-speck" cx="54" cy="52" r="0.35" />
        <circle class="speck yellow-speck" cx="66" cy="36" r="0.45" />
        <circle class="speck blue-speck" cx="72" cy="50" r="0.5" />
        <circle class="speck yellow-speck" cx="8" cy="54" r="0.3" />
        <circle class="speck blue-speck" cx="40" cy="60" r="0.4" />
        <circle class="speck yellow-speck" cx="84" cy="40" r="0.35" />
      </g>
    ) : treat === 'dunk' && side === 0 ? (
      <g>
        <path class="pool red" d="M0 74 C 14 64, 24 84, 42 72 C 58 60, 74 86, 100 70 L 100 125 L 0 125 Z" />
        <path class="tide" d="M2 74 C 16 66, 26 82, 44 72 C 60 62, 76 84, 98 70" />
        <path class="drip red-drip" d="M22 72 L 20 58" />
        <path class="drip red-drip" d="M48 66 L 50 48" />
        <path class="drip red-drip" d="M76 78 L 74 60" />
      </g>
    ) : treat === 'dunk' ? (
      <g>
        <path class="pool blue" d="M0 0 L 38 0 C 48 18, 28 36, 42 54 C 52 70, 34 88, 28 125 L 0 125 Z" />
        <path class="tide" d="M36 4 C 46 20, 30 38, 40 56 C 50 72, 32 90, 28 122" />
        <path class="drip blue-drip" d="M40 28 L 56 30" />
        <path class="drip blue-drip" d="M42 52 L 64 48" />
        <path class="drip yellow-drip" d="M36 78 L 52 82" />
      </g>
    ) : treat === 'rothko' ? null : which === 0 ? (
      <g>
        <polygon class="block yellow" points="0,0 46,3 50,42 0,48" />
        <polygon class="block red" points="48,82 100,72 100,125 42,118" />
        <polygon class="block blue" points="0,68 26,62 30,112 0,118" />
        <path class="ink heavy" d="M2 50 C 20 38, 40 62, 58 44 S 86 34, 99 52" />
        <path class="ink heavy" d="M62 8 C 74 0, 92 8, 90 26 C 88 42, 66 40, 58 22 C 54 12, 58 8, 62 8" />
        <path class="ink" d="M10 22 L 28 8 L 22 28 L 12 24 Z" />
        <path class="ink" d="M70 58 L 96 50 M 72 66 L 98 56 M 76 74 L 99 64" />
        <path class="crayon" d="M36 70 C 52 60, 68 78, 90 66" />
        <path class="ground" d="M6 102 L 18 90 M 12 108 L 26 92 M 18 114 L 34 96" />
        <circle class="dot" cx="54" cy="18" r="1.2" />
        <circle class="dot" cx="58" cy="15" r="0.9" />
        <circle class="dot" cx="62" cy="19" r="1.15" />
      </g>
    ) : which === 1 ? (
      <g>
        <polygon class="block blue" points="0,88 52,80 56,125 0,125" />
        <polygon class="block yellow" points="58,0 100,4 96,40 54,32" />
        <polygon class="block red" points="0,4 28,0 32,36 0,40" />
        <path class="ink heavy" d="M14 16 L 48 52 M 48 14 L 12 54" />
        <path class="ink heavy" d="M6 64 C 28 52, 48 76, 96 58" />
        <path class="ink" d="M54 48 C 64 32, 92 34, 96 54 C 100 76, 70 84, 52 64" />
        <path class="ink" d="M70 96 L 92 88 M 74 104 L 98 94" />
        <path class="crayon" d="M20 74 C 34 68, 28 86, 44 80" />
        <path class="ground" d="M64 112 L 92 104" />
        <circle class="dot" cx="40" cy="28" r="1.2" />
        <circle class="dot" cx="44" cy="24" r="1" />
        <circle class="dot" cx="48" cy="30" r="1.3" />
        <circle class="dot" cx="52" cy="25" r="0.8" />
      </g>
    ) : (
      <g>
        <polygon class="block red" points="0,36 34,28 40,86 0,92" />
        <polygon class="block yellow" points="46,6 100,2 100,40 50,46" />
        <polygon class="block blue" points="58,78 100,70 100,112 52,118" />
        <path class="ink heavy" d="M24 16 C 46 8, 72 24, 98 12" />
        <path class="ink heavy" d="M8 108 C 32 92, 58 118, 96 100" />
        <path class="ink" d="M48 52 C 58 40, 78 44, 82 60 C 86 76, 62 80, 50 66" />
        <path class="ink" d="M68 50 l 12 -18 l 10 20 l -20 6 z" />
        <path class="crayon" d="M8 24 C 20 16, 16 32, 28 26" />
        <path class="ground" d="M12 70 L 22 60 M 16 76 L 28 64" />
        <circle class="dot" cx="44" cy="22" r="1.15" />
        <circle class="dot" cx="48" cy="18" r="1" />
        <circle class="dot" cx="53" cy="23" r="1.25" />
        <circle class="dot" cx="57" cy="19" r="0.85" />
      </g>
    )
  }
</svg>

<style>
  .marks {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .sheet {
    z-index: 0;
  }

  .block {
    opacity: 0.92;
  }

  .yellow {
    fill: #f2d21a;
  }

  .red {
    fill: #e23b2f;
  }

  .blue {
    fill: #1a3fbf;
  }

  .ink {
    fill: none;
    stroke: #14110e;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .heavy {
    stroke-width: 3.1;
  }

  .crayon {
    fill: none;
    stroke: #e23b2f;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .ground {
    fill: none;
    stroke: #f7f1e4;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .dot {
    fill: #14110e;
  }

  .rothko {
    position: absolute;
    inset: 8% 10% 9%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .band {
    display: block;
    width: 100%;
  }

  .band-a {
    height: 27%;
    background: rgba(168, 42, 32, 0.9);
    box-shadow:
      0 0 28px 10px rgba(168, 42, 32, 0.45),
      inset 0 0 16px rgba(0, 0, 0, 0.28);
  }

  .band-b {
    height: 36%;
    background: rgba(214, 108, 36, 0.86);
    box-shadow:
      0 0 34px 12px rgba(214, 108, 36, 0.42),
      inset 0 0 18px rgba(0, 0, 0, 0.22);
  }

  .band-c {
    height: 24%;
    background: rgba(36, 14, 24, 0.92);
    box-shadow:
      0 0 26px 8px rgba(36, 14, 24, 0.55),
      inset 0 0 14px rgba(0, 0, 0, 0.35);
  }

  .spray-stroke {
    fill: none;
    stroke: #14110e;
    stroke-width: 6.4;
    stroke-linecap: round;
    opacity: 0.82;
    filter: blur(0.65px);
  }

  .yellow-stroke {
    stroke: #f2d21a;
  }

  .drip {
    fill: none;
    stroke: #14110e;
    stroke-width: 1.35;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .red-drip {
    stroke: #e23b2f;
  }

  .yellow-drip {
    stroke: #f2d21a;
    stroke-width: 1.7;
  }

  .blue-drip {
    stroke: #1a3fbf;
  }

  .speck {
    fill: #14110e;
    opacity: 0.75;
    filter: blur(0.25px);
  }

  .red-speck {
    fill: #e23b2f;
  }

  .yellow-speck {
    fill: #f2d21a;
  }

  .blue-speck {
    fill: #1a3fbf;
  }

  .pool {
    opacity: 0.94;
  }

  .tide {
    fill: none;
    stroke: rgba(255, 248, 236, 0.55);
    stroke-width: 1.15;
    stroke-linecap: round;
  }
</style>
