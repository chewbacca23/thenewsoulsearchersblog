---
import { site } from '../site.config';
import BrandMark from './BrandMark.astro';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const instagram = instagramBind(settings);

type NavLink = { href: string; label: string; match?: string; private?: boolean };
type NavItem =
  | { type: 'link'; href: string; label: string; match?: string; private?: boolean }
  | { type: 'group'; label: string; children: NavLink[] };

const items: NavItem[] = [
  { type: 'link', href: '/', label: 'Home' },
  { type: 'link', href: '/stories', label: 'Rides' },
  {
    type: 'group',
    label: 'Trail',
    children: [
      { href: '/postcard', label: 'Postcards', match: '/postcard' },
      { href: '/stood', label: 'Where I stood' },
      { href: '/week', label: 'This week' },
      { href: '/calendar', label: 'Berlin calendar' },
    ],
  },
  {
    type: 'group',
    label: 'Places',
    children: [
      { href: '/cities', label: 'Cities', match: '/cities' },
      { href: '/stores', label: 'Stores' },
      { href: '/friends', label: 'Friends' },
      { href: '/members', label: 'Members', private: true },
    ],
  },
  { type: 'link', href: '/marketplace', label: 'Fresh stuff' },
  {
    type: 'group',
    label: 'Kit',
    children: [
      { href: '/shop', label: 'Shop' },
      { href: '/kit', label: 'Soul Searchers Kit' },
    ],
  },
  { type: 'link', href: '/about', label: 'About' },
  { type: 'link', href: '/contact', label: 'Contact' },
];

function linkActive(href: string, match?: string) {
  if (pathname === href) return true;
  if (match && (pathname === match || pathname.startsWith(`${match}/`))) return true;
  return false;
}

function groupActive(children: NavLink[]) {
  return children.some((child) => linkActive(child.href, child.match));
}
---

<header class:list={['header', { 'header--home': isHome }]} style={isHome ? '--crest: 0;' : undefined}>
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src={site.logo} alt="" width="40" height="51" decoding="async" />
      <BrandMark class="brand-text" />
    </a>
    <nav class="nav" aria-label="Primary" data-site-nav>
      {
        items.map((item) =>
          item.type === 'link' ? (
            <a
              href={item.href}
              class:list={['nav-link', { active: linkActive(item.href, item.match) }]}
              aria-current={linkActive(item.href, item.match) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <details class:list={['nav-drop', { active: groupActive(item.children) }]}>
              <summary class="nav-link nav-drop-summary">
                {item.label}
                <span class="nav-drop-caret" aria-hidden="true"></span>
              </summary>
              <div class="nav-drop-panel" role="group" aria-label={item.label}>
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'nav-drop-link',
                      { active: linkActive(child.href, child.match), 'nav-drop-link--private': child.private },
                    ]}
                    aria-current={linkActive(child.href, child.match) ? 'page' : undefined}
                    title={child.private ? 'Private for you' : undefined}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )
      }
      {
        instagram && (
          <a
            class="nav-link"
            href={instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-site-nav]');
    if (!nav) return;
    var drops = nav.querySelectorAll('details.nav-drop');

    drops.forEach(function (drop) {
      drop.addEventListener('toggle', function () {
        if (!drop.open) return;
        drops.forEach(function (other) {
          if (other !== drop) other.open = false;
        });
      });
    });

    document.addEventListener('click', function (event) {
      if (nav.contains(event.target)) return;
      drops.forEach(function (drop) {
        drop.open = false;
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      drops.forEach(function (drop) {
        drop.open = false;
      });
    });
  })();
</script>

{
  isHome && (
    <script is:inline>
      (function () {
        function bindCrestFlight() {
          var header = document.querySelector('.header--home');
          var heroCrest = document.querySelector('.hero-logo');
          var headerCrest = header && header.querySelector('.brand-logo');
          if (!header || !headerCrest || !heroCrest) {
            if (header) header.style.setProperty('--crest', '1');
            return;
          }

          // Crest morph is the continuity of one mark, not decorative motion.
          // Always run a timed glide. Mac “Reduce motion” was skipping to a flick.
          var DURATION = 1200;
          var state = 'hero'; // hero | flying | header
          var flying = false;
          var flightAnim = null;
          var slotRaf = 0;

          var flyer = document.createElement('img');
          flyer.className = 'crest-flyer';
          flyer.src = heroCrest.currentSrc || heroCrest.src;
          flyer.alt = '';
          flyer.setAttribute('aria-hidden', 'true');
          flyer.decoding = 'async';
          document.body.appendChild(flyer);

          function easeInOut(t) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function copyBox(box) {
            return {
              left: box.left,
              top: box.top,
              width: Math.max(box.width, 1),
              height: Math.max(box.height, 1),
            };
          }

          // Land where the header crest will sit once --crest opens (brand left edge).
          function headerSlot() {
            var brand = header.querySelector('.brand').getBoundingClientRect();
            var bar = header.querySelector('.header-inner').getBoundingClientRect();
            var width = 38.4;
            var height = width * (51 / 40);
            return {
              left: brand.left,
              top: bar.top + (bar.height - height) / 2,
              width: width,
              height: height,
            };
          }

          function hideFlyer() {
            flyer.style.opacity = '0';
            flyer.style.visibility = 'hidden';
            flyer.style.transform = 'translate3d(-9999px, -9999px, 0)';
          }

          function showHero() {
            heroCrest.style.removeProperty('opacity');
            heroCrest.style.removeProperty('visibility');
            heroCrest.style.removeProperty('transform');
          }

          function hideHero() {
            heroCrest.style.setProperty('opacity', '0', 'important');
            heroCrest.style.setProperty('visibility', 'hidden', 'important');
            heroCrest.style.setProperty('transform', 'none', 'important');
          }

          function setHeaderCrest(on) {
            header.style.setProperty('--crest', on ? '1' : '0');
            header.classList.toggle('crest-in', !!on);
          }

          function placeFlyer(box) {
            flyer.style.visibility = 'visible';
            flyer.style.opacity = '1';
            flyer.style.width = box.width.toFixed(2) + 'px';
            flyer.style.height = 'auto';
            flyer.style.transform =
              'translate3d(' + box.left.toFixed(2) + 'px, ' + box.top.toFixed(2) + 'px, 0)';
          }

          function cancelFlight() {
            if (flightAnim) {
              try {
                flightAnim.cancel();
              } catch (e) {}
              flightAnim = null;
            }
            if (slotRaf) {
              window.cancelAnimationFrame(slotRaf);
              slotRaf = 0;
            }
          }

          function finish(up) {
            cancelFlight();
            flying = false;
            hideFlyer();
            if (up) {
              state = 'header';
              hideHero();
              setHeaderCrest(true);
            } else {
              state = 'hero';
              showHero();
              setHeaderCrest(false);
            }
          }

          function animateSlot(up, startedAt) {
            function tick(now) {
              if (!flying) return;
              var t = (now - startedAt) / DURATION;
              if (t > 1) t = 1;
              var e = easeInOut(t);
              var slot = up ? e : 1 - e;
              header.style.setProperty('--crest', slot.toFixed(4));
              if (t < 1) {
                slotRaf = window.requestAnimationFrame(tick);
              } else {
                slotRaf = 0;
              }
            }
            slotRaf = window.requestAnimationFrame(tick);
          }

          function startFlight(up) {
            cancelFlight();

            var fromBox;
            var toBox;

            if (up) {
              fromBox = copyBox(heroCrest.getBoundingClientRect());
              toBox = headerSlot();
              // Trackpad jumps leave the crest already at the bar. Invent a start
              // so the eye still gets a full on-screen glide.
              var minTravel = 240;
              if (fromBox.top < toBox.top + minTravel) {
                fromBox.top = Math.min(window.innerHeight * 0.55, toBox.top + 380);
                fromBox.left = Math.max(
                  16,
                  Math.min(fromBox.left || toBox.left + 48, window.innerWidth * 0.42)
                );
                fromBox.width = Math.max(fromBox.width, 112);
                fromBox.height = fromBox.width * (51 / 40);
              }
              hideHero();
              setHeaderCrest(false);
            } else {
              fromBox = headerSlot();
              setHeaderCrest(false);
              showHero();
              toBox = copyBox(heroCrest.getBoundingClientRect());
              hideHero();
              // If the hero mark is off-screen, drop toward mid viewport.
              if (toBox.top < 80 || toBox.top > window.innerHeight) {
                toBox.top = Math.min(window.innerHeight * 0.5, 360);
                toBox.left = Math.max(16, Math.min(toBox.left, window.innerWidth * 0.4));
                toBox.width = Math.max(toBox.width, 112);
                toBox.height = toBox.width * (51 / 40);
              }
            }

            flying = true;
            state = 'flying';
            placeFlyer(fromBox);
            animateSlot(up, performance.now());

            var fromTf =
              'translate3d(' + fromBox.left.toFixed(2) + 'px, ' + fromBox.top.toFixed(2) + 'px, 0)';
            var toTf =
              'translate3d(' + toBox.left.toFixed(2) + 'px, ' + toBox.top.toFixed(2) + 'px, 0)';

            if (typeof flyer.animate === 'function') {
              flightAnim = flyer.animate(
                [
                  { transform: fromTf, width: fromBox.width.toFixed(2) + 'px', opacity: 1 },
                  { transform: toTf, width: toBox.width.toFixed(2) + 'px', opacity: 1 },
                ],
                {
                  duration: DURATION,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  fill: 'forwards',
                }
              );
              flightAnim.onfinish = function () {
                finish(up);
              };
              flightAnim.oncancel = function () {
                /* finish() also cancels */
              };
            } else {
              // Fallback: rAF lerp if WAAPI missing
              var startedAt = performance.now();
              function step(now) {
                if (!flying) return;
                var t = (now - startedAt) / DURATION;
                if (t >= 1) {
                  placeFlyer(toBox);
                  finish(up);
                  return;
                }
                var e = easeInOut(t);
                placeFlyer({
                  left: fromBox.left + (toBox.left - fromBox.left) * e,
                  top: fromBox.top + (toBox.top - fromBox.top) * e,
                  width: fromBox.width + (toBox.width - fromBox.width) * e,
                  height: fromBox.height + (toBox.height - fromBox.height) * e,
                });
                window.requestAnimationFrame(step);
              }
              window.requestAnimationFrame(step);
            }
          }

          function shouldFlyUp() {
            if (window.scrollY < 48) return false;
            var hero = heroCrest.getBoundingClientRect();
            var barBottom = header.getBoundingClientRect().bottom;
            return hero.top < barBottom + 240 || hero.top < window.innerHeight * 0.4;
          }

          function shouldFlyDown() {
            if (window.scrollY < 24) return true;
            var hero = heroCrest.getBoundingClientRect();
            return hero.top > window.innerHeight * 0.55;
          }

          function onScroll() {
            if (flying) return;
            if (state === 'hero' && shouldFlyUp()) {
              startFlight(true);
              return;
            }
            if (state === 'header' && shouldFlyDown()) {
              startFlight(false);
            }
          }

          hideFlyer();
          setHeaderCrest(false);
          showHero();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', function () {
            if (state === 'header') setHeaderCrest(true);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindCrestFlight);
        } else {
          bindCrestFlight();
        }
      })();
    </script>
  )
}

<style is:global>
  .crest-flyer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 120;
    width: 4rem;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translate3d(-9999px, -9999px, 0);
    filter: drop-shadow(0 14px 34px rgba(212, 163, 90, 0.45));
    will-change: transform, width, opacity;
    transform-origin: top left;
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(215, 224, 232, 0.06);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(16px) saturate(1.1);
    overflow: visible;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    overflow: visible;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-logo {
    width: auto;
    height: 2.75rem;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(212, 163, 90, 0.35));
  }

  .header--home {
    --crest: 0;
  }

  .header--home .brand {
    gap: calc(0.75rem * var(--crest));
  }

  .header--home .brand-logo {
    width: auto;
    height: 2.75rem;
    max-height: calc(2.75rem * var(--crest));
    max-width: calc(1.75rem * var(--crest));
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .header--home.crest-in .brand-logo {
    opacity: 1;
    pointer-events: auto;
  }

  /* Cap height matches the crest beside it — same slim Extra Condensed as the hero. */
  .brand-text {
    font-family: var(--font-display);
    font-size: 2.55rem;
    font-weight: 300;
    letter-spacing: 0;
    line-height: 0.85;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  /* Same box for plain links and dropdowns so the row sits on one line. */
  .nav > .nav-link,
  .nav > .nav-drop {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .nav-link {
    color: rgba(215, 224, 232, 0.72);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active,
  .nav-drop.active > .nav-drop-summary {
    color: var(--amber-hot);
  }

  .nav-drop {
    position: relative;
  }

  .nav-drop-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    height: 100%;
    margin: 0;
    padding: 0;
    line-height: 1;
    cursor: pointer;
    list-style: none;
  }

  .nav-drop-summary::-webkit-details-marker {
    display: none;
  }

  .nav-drop-caret {
    display: block;
    flex: 0 0 auto;
    width: 0.34rem;
    height: 0.34rem;
    margin: 0;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.7;
    transition: transform 160ms ease;
  }

  .nav-drop[open] > .nav-drop-summary .nav-drop-caret {
    transform: rotate(225deg);
  }

  .nav-drop-panel {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    min-width: 11.5rem;
    padding: 0.45rem;
    border: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 0.75rem;
    background:
      linear-gradient(180deg, rgba(22, 30, 40, 0.98), rgba(12, 16, 22, 0.98));
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    display: grid;
    gap: 0.15rem;
    z-index: 50;
  }

  .nav-drop-link {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 0.5rem;
    color: rgba(215, 224, 232, 0.78);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .nav-drop-link:hover,
  .nav-drop-link.active {
    color: var(--amber-hot);
    background: rgba(212, 163, 90, 0.1);
  }

  /* Henrik-only cue: private pages in green so they stand out in the menu */
  .nav-drop-link--private {
    color: #6fcf8a;
    font-weight: 650;
  }

  .nav-drop-link--private:hover,
  .nav-drop-link--private.active {
    color: #9aefb0;
    background: rgba(111, 207, 138, 0.12);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.85rem;
    }

    .nav {
      justify-content: flex-start;
    }

    .nav-drop-panel {
      right: auto;
      left: 0;
    }
  }
</style>
