---
import { AWESOME_LABEL, POSITIVE_LEAD } from '../../cloudflare/kind-remarks.js';

interface Props {
  path?: string;
}

const rawPath = Astro.props.path ?? Astro.url.pathname;
const normalized =
  rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath || '/';
const skip =
  normalized.startsWith('/admin') ||
  normalized === '/looks' ||
  normalized === '/members' ||
  normalized === '/auth' ||
  normalized === '/callback';
---

{
  !skip && (
    <section class="kind-remarks" data-kind-remarks data-path={normalized} aria-label="Kind words">
      <div class="site-shell kind-inner">
        <div class="kind-panel" data-kind-panel>
          <h2 class="kind-title">Kind words</h2>
          <p class="kind-lead">{POSITIVE_LEAD}</p>
          <div class="kind-awesome-row">
            <button class="btn btn-primary kind-awesome-btn" type="button" data-kind-awesome>
              {AWESOME_LABEL}
            </button>
            <span class="kind-awesome-count" data-kind-awesome-count hidden></span>
          </div>
          <ul class="kind-list" data-kind-list hidden></ul>
          <p class="kind-empty" data-kind-empty>
            Kind words show here when someone leaves the first one.
          </p>
          <p class="kind-status" data-kind-status hidden></p>
          <form class="kind-form" data-kind-form>
            <label>
              <span>
                Name <em>(optional)</em>
              </span>
              <input type="text" name="name" maxlength="40" autocomplete="nickname" />
            </label>
            <label>
              <span>Your kind word</span>
              <textarea name="message" rows="2" required maxlength="280" minlength="8"></textarea>
            </label>
            <label class="kind-hp" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit">Leave a kind word</button>
          </form>
        </div>

        <div class="kind-member" id="become-a-member" data-kind-member>
          <h2 class="kind-title">Become a member</h2>
          <p class="kind-lead">
            Free on thenewsoulsearchers.de. Add your email to our list.<br />
            We keep one big group so we can write you back. Always free.
          </p>
          <p class="kind-status" data-member-status hidden></p>
          <form class="kind-form" data-member-form>
            <label>
              <span>
                Name <em>(optional)</em>
              </span>
              <input type="text" name="name" maxlength="80" autocomplete="name" />
            </label>
            <label>
              <span>Your email</span>
              <input type="email" name="email" required maxlength="200" autocomplete="email" />
            </label>
            <label class="kind-hp" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit">Join free</button>
          </form>
        </div>
      </div>
    </section>
  )
}

{
  !skip && (
    <script is:inline>
      (function () {
        var root = document.querySelector('[data-kind-remarks]');
        if (!root) return;
        var path = root.getAttribute('data-path') || location.pathname || '/';
        if (path.length > 1 && path.charAt(path.length - 1) === '/') path = path.slice(0, -1);
        var list = root.querySelector('[data-kind-list]');
        var empty = root.querySelector('[data-kind-empty]');
        var status = root.querySelector('[data-kind-status]');
        var form = root.querySelector('[data-kind-form]');
        var awesomeBtn = root.querySelector('[data-kind-awesome]');
        var awesomeCount = root.querySelector('[data-kind-awesome-count]');
        var awesomeStoreKey = 'ss-awesome:' + path;

        function showStatus(text, tone) {
          if (!status) return;
          status.hidden = !text;
          status.textContent = text || '';
          status.setAttribute('data-tone', tone || '');
        }

        function escapeText(value) {
          return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function paint(items) {
          if (!list || !empty) return;
          list.innerHTML = '';
          if (!items || !items.length) {
            list.hidden = true;
            empty.hidden = false;
            return;
          }
          empty.hidden = true;
          list.hidden = false;
          items.forEach(function (item) {
            var li = document.createElement('li');
            var who = item.name ? '<span class="who">· ' + escapeText(item.name) + '</span>' : '';
            li.innerHTML = '<span class="said">' + escapeText(item.message) + '</span>' + who;
            list.appendChild(li);
          });
        }

        function paintAwesome(n) {
          var count = Number(n) || 0;
          if (!awesomeCount) return;
          if (count < 1) {
            awesomeCount.hidden = true;
            awesomeCount.textContent = '';
            awesomeCount.removeAttribute('aria-label');
            return;
          }
          awesomeCount.hidden = false;
          awesomeCount.textContent = '· ' + count;
          awesomeCount.setAttribute('aria-label', count === 1 ? '1 person' : count + ' people');
        }

        function alreadyAwesome() {
          try {
            return localStorage.getItem(awesomeStoreKey) === '1';
          } catch (e) {
            return false;
          }
        }

        function rememberAwesome() {
          try {
            localStorage.setItem(awesomeStoreKey, '1');
          } catch (e) {}
          if (awesomeBtn) {
            awesomeBtn.disabled = true;
            awesomeBtn.setAttribute('aria-pressed', 'true');
          }
        }

        if (alreadyAwesome()) rememberAwesome();

        fetch('/api/remarks?path=' + encodeURIComponent(path), {
          headers: { accept: 'application/json' },
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (data) {
            paint(data && data.remarks ? data.remarks : []);
            paintAwesome(data && data.awesome);
          })
          .catch(function () {});

        if (awesomeBtn) {
          awesomeBtn.addEventListener('click', function () {
            if (awesomeBtn.getAttribute('aria-pressed') === 'true') return;
            showStatus('', '');
            awesomeBtn.disabled = true;
            var hp = form ? form.querySelector('input[name="website"]') : null;
            fetch('/api/remarks', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({
                path: path,
                kind: 'awesome',
                website: hp ? String(hp.value || '') : '',
              }),
            })
              .then(function (res) {
                return res.json().then(function (data) {
                  return { ok: res.ok, data: data };
                });
              })
              .then(function (result) {
                if (!result.ok || !result.data || !result.data.ok) {
                  if (!alreadyAwesome()) awesomeBtn.disabled = false;
                  showStatus(
                    (result.data && result.data.error) || 'Could not save that just now.',
                    'bad',
                  );
                  return;
                }
                if (result.data.via === 'discard') {
                  awesomeBtn.disabled = false;
                  return;
                }
                rememberAwesome();
                paintAwesome(result.data.awesome);
              })
              .catch(function () {
                if (!alreadyAwesome()) awesomeBtn.disabled = false;
                showStatus('Could not save that just now.', 'bad');
              });
          });
        }

        if (form) {
          form.addEventListener('submit', function (event) {
            event.preventDefault();
            showStatus('', '');
            var fd = new FormData(form);
            var payload = {
              path: path,
              name: String(fd.get('name') || ''),
              message: String(fd.get('message') || ''),
              website: String(fd.get('website') || ''),
            };
            var button = form.querySelector('button[type="submit"]');
            if (button) button.disabled = true;
            fetch('/api/remarks', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify(payload),
            })
              .then(function (res) {
                return res.json().then(function (data) {
                  return { ok: res.ok, data: data };
                });
              })
              .then(function (result) {
                if (!result.ok || !result.data || !result.data.ok) {
                  showStatus(
                    (result.data && result.data.error) || 'Could not save that just now.',
                    'bad',
                  );
                  return;
                }
                form.reset();
                showStatus('Thank you. Your kind word is on the page.', 'ok');
                return fetch('/api/remarks?path=' + encodeURIComponent(path), {
                  headers: { accept: 'application/json' },
                })
                  .then(function (res) {
                    return res.json();
                  })
                  .then(function (data) {
                    paint(data && data.remarks ? data.remarks : []);
                  });
              })
              .catch(function () {
                showStatus('Could not save that just now.', 'bad');
              })
              .finally(function () {
                if (button) button.disabled = false;
              });
          });
        }

        var memberForm = root.querySelector('[data-member-form]');
        var memberStatus = root.querySelector('[data-member-status]');
        function showMemberStatus(text, tone) {
          if (!memberStatus) return;
          memberStatus.hidden = !text;
          memberStatus.textContent = text || '';
          memberStatus.setAttribute('data-tone', tone || '');
        }
        if (memberForm) {
          memberForm.addEventListener('submit', function (event) {
            event.preventDefault();
            showMemberStatus('', '');
            var fd = new FormData(memberForm);
            var payload = {
              name: String(fd.get('name') || ''),
              email: String(fd.get('email') || ''),
              website: String(fd.get('website') || ''),
            };
            var button = memberForm.querySelector('button[type="submit"]');
            if (button) button.disabled = true;
            fetch('/api/members', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify(payload),
            })
              .then(function (res) {
                return res.json().then(function (data) {
                  return { ok: res.ok, data: data };
                });
              })
              .then(function (result) {
                if (!result.ok || !result.data || !result.data.ok) {
                  showMemberStatus(
                    (result.data && result.data.error) || 'Could not join just now.',
                    'bad',
                  );
                  return;
                }
                memberForm.reset();
                showMemberStatus(
                  (result.data && result.data.message) ||
                    'Welcome. You are on the free list.',
                  'ok',
                );
              })
              .catch(function () {
                showMemberStatus('Could not join just now.', 'bad');
              })
              .finally(function () {
                if (button) button.disabled = false;
              });
          });
        }
      })();
    </script>
  )
}

<style>
  .kind-remarks {
    margin-top: auto;
    padding: 1.15rem 0 1.5rem;
    border-top: 1px solid rgba(215, 224, 232, 0.08);
    background: linear-gradient(180deg, transparent, rgba(30, 58, 69, 0.16));
  }

  .kind-inner {
    display: grid;
    gap: 0.85rem;
    align-items: stretch;
  }

  @media (min-width: 720px) {
    .kind-inner {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  .kind-panel,
  .kind-member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-width: 0;
    padding: 0.85rem 0.95rem 0.95rem;
    border: 1px solid rgba(215, 224, 232, 0.14);
    border-radius: 0.35rem;
    background: rgba(8, 12, 17, 0.42);
    box-sizing: border-box;
  }

  .kind-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--paper);
  }

  .kind-lead,
  .kind-empty,
  .kind-status {
    margin: 0;
    color: rgba(215, 224, 232, 0.58);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .kind-awesome-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .kind-awesome-btn {
    justify-self: start;
  }

  .kind-awesome-btn:disabled {
    opacity: 0.65;
    cursor: default;
    transform: none;
  }

  .kind-awesome-count {
    color: rgba(215, 224, 232, 0.72);
    font-size: 0.78rem;
  }

  .kind-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .kind-list li {
    margin: 0;
    color: rgba(238, 243, 247, 0.82);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .kind-list :global(.who) {
    display: inline;
    margin-left: 0.35rem;
    color: rgba(215, 224, 232, 0.45);
    font-size: 0.74rem;
  }

  .kind-form {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .kind-form label {
    display: grid;
    gap: 0.2rem;
    color: rgba(215, 224, 232, 0.68);
    font-size: 0.74rem;
  }

  .kind-form em {
    font-style: normal;
    opacity: 0.7;
  }

  .kind-form input,
  .kind-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(215, 224, 232, 0.14);
    border-radius: 0.3rem;
    background: rgba(8, 12, 17, 0.5);
    color: var(--paper);
    padding: 0.4rem 0.55rem;
    font: inherit;
    font-size: 0.82rem;
  }

  .kind-form :global(.btn) {
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
  }

  .kind-form button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .kind-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .kind-status[data-tone='bad'] {
    color: #e8b4a2;
  }

  .kind-status[data-tone='ok'] {
    color: #b7d4c4;
  }
</style>
